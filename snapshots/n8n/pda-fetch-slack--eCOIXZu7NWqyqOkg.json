      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1
    },
    {
      "parameters": {
        "jsCode": "// ── 1. User ID lookup ──────────────────────────────────────────────────────────────────────\nconst USERS = {\n  'U01LXU0K3DG': 'Tim',\n  'U01MAH5A6N5': 'Jess',\n  'U03QQ1H8M5E': 'Joe',\n};\n\nconst TIM_USER_ID = 'U01LXU0K3DG';\n\nfunction resolveUser(id) {\n  return USERS[id] || id || 'unknown';\n}\n\n// ── 2. Timestamp conversion — Slack Unix ts → UTC ISO ────────────────────────────────────\nfunction slackTsToUTC(ts) {\n  if (!ts) return null;\n  return new Date(Math.floor(parseFloat(ts) * 1000)).toISOString();\n}\n\n// ── 3. Helpers ────────────────────────────────────────────────────────────────────────\nfunction decodeEntities(str) {\n  if (!str) return '';\n  return str\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\")\n    .replace(/&apos;/g, \"'\");\n}\n\nfunction cleanSlackText(text) {\n  if (!text) return '';\n  let clean = text\n    .replace(/<@([A-Z0-9]+)>/g, (_, id) => `@${resolveUser(id)}`)\n    .replace(/<!here>/g, '@here')\n    .replace(/<!channel>/g, '@channel')\n    .replace(/<!everyone>/g, '@everyone')\n    .replace(/<#[A-Z0-9]+\\|([^>]+)>/g, '#$1')\n    .replace(/<([^|>]+)\\|([^>]+)>/g, '$2')\n    .replace(/<(https?:\\/\\/[^>]+)>/g, '$1')\n    .replace(/\\s+/g, ' ')\n    .trim();\n  return decodeEntities(clean).substring(0, 1500);\n}\n\n// ── 4. Read inputs — channel names from Config ─────────────────────────────────────\nconst channelNames = $('Config').first().json.slack_channels || ['ijm', 'ijm-post', 'vessev', 'admin'];\nconst channelsData = $('Channels – Aggregate').first().json.data || [];\nconst dmsData = $input.first().json.data || [];\n\n// ── 5. Build message objects ───────────────────────────────────────────────────────────────────\nconst messages = [];\n\n// Channel messages\nchannelsData.forEach((historyResponse, i) => {\n  const channelName = channelNames[i] || `channel_${i}`;\n  const msgs = historyResponse.messages || [];\n\n  for (const msg of msgs) {\n    if (!msg.ts) continue;\n    if (!msg.type === 'message') continue;\n    const text = cleanSlackText(msg.text || '');\n    if (!text) continue;\n\n    messages.push({\n      source:     'slack',\n      message_id: `${channelName}_${msg.ts}`,\n      thread_id:  msg.thread_ts && msg.thread_ts !== msg.ts ? `${channelName}_${msg.thread_ts}` : null,\n      timestamp:  slackTsToUTC(msg.ts),\n      timezone:   'UTC',\n      channel:    `#${channelName}`,\n      sender:     resolveUser(msg.user || msg.username || ''),\n      body:       text,\n      reactions:  (msg.reactions || []).map(r => `${r.name}(${r.count})`),\n      is_reply:   !!(msg.thread_ts && msg.thread_ts !== msg.ts),\n      url:        null\n    });\n  }\n});\n\n// DM messages\ndmsData.forEach((historyResponse) => {\n  const msgs = (historyResponse.messages || [])\n    .filter(m => m.type === 'message' && !m.subtype);\n\n  if (msgs.length === 0) return;\n\n  const partner = msgs.find(m => m.user && m.user !== TIM_USER_ID);\n  const partnerName = partner ? resolveUser(partner.user) : 'Unknown';\n\n  for (const msg of msgs) {\n    if (!msg.ts) continue;\n    const text = cleanSlackText(msg.text || '');\n    if (!text) continue;\n\n    messages.push({\n      source:     'slack',\n      message_id: `dm_${partnerName}_${msg.ts}`,\n      thread_id:  msg.thread_ts && msg.thread_ts !== msg.ts ? `dm_${partnerName}_${msg.thread_ts}` : null,\n      timestamp:  slackTsToUTC(msg.ts),\n      timezone:   'UTC',\n      channel:    `DM:${partnerName}`,\n      sender:     resolveUser(msg.user || ''),\n      body:       text,\n      reactions:  (msg.reactions || []).map(r => `${r.name}(${r.count})`),\n      is_reply:   !!(msg.thread_ts && msg.thread_ts !== msg.ts),\n      url:        null\n    });\n  }\n});\n\n// Sort ascending by timestamp (oldest first)\nmessages.sort((a, b) => {\n  if (!a.timestamp) return 1;\n  if (!b.timestamp) return -1;\n  return a.timestamp.localeCompare(b.timestamp);\n});\n\n// ── 6. Wrap in fenced JSON block for Obsidian ─────────────────────────────────────────\nconst fence = '```';\nconst content = `${fence}json\\n${JSON.stringify(messages, null, 2)}\\n${fence}`;\n\nreturn [{ json: { content } }];"
      },
