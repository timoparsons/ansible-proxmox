    {
      "parameters": {
        "jsCode": "// Read slack_channels from Config (sourced from PDA Master passthrough, or stub defaults for standalone runs)\nconst channelNames = $('Config').first().json.slack_channels || ['ijm', 'ijm-post', 'vessev', 'admin'];\nconst allChannels = $('Slack - Get All Channels').all();\n\n// Build name → ID lookup\nconst channelMap = {};\nallChannels.forEach(item => {\n  channelMap[item.json.name.toLowerCase()] = item.json.id;\n});\n\nconst channels = [];\nfor (const name of channelNames) {\n  const lower = name.toLowerCase();\n  const id = channelMap[lower];\n  if (id) {\n    channels.push({ json: { channelName: lower, channelId: id } });\n  } else {\n    channels.push({ json: { channelName: lower, channelId: null, error: 'NOT FOUND' } });\n  }\n}\n\nreturn channels;"
      },
