    {
      "parameters": {
        "jsCode": "// ── Compute feedsSince (UTC Standardized) ─────────────────────────────────────────────\nconst BASE = 'https://10.1.1.200:27124';\nconst API_KEY = 'REDACTED'; // <-- PASTE YOUR API KEY HERE\n\nconst MAX_LOOKBACK_DAYS = 7;\nconst FEED_BUFFER_MINS = $input.first().json.feed_buffer_mins ?? 30;\n\n// UTC Date Helpers\nfunction formatUTC(date) {\n  return date.toISOString(); \n}\n\nfunction adjustMinutesUTC(isoStr, mins) {\n  const d = new Date(isoStr);\n  d.setUTCMinutes(d.getUTCMinutes() + mins);\n  return d.toISOString();\n}\n\nfunction adjustDaysUTC(isoStr, days) {\n  const d = new Date(isoStr);\n  d.setUTCDate(d.getUTCDate() + days);\n  return d.toISOString();\n}\n\nfunction extractGeneratedAt(content) {\n  const m = content.match(/generated_at:\\s*[\"']?([\\d\\-\\:T\\.Z]+)[\"']?/);\n  return m ? m[1] : null;\n}\n\nconst nowUTC = new Date();\nconst todayStr = nowUTC.toISOString().split('T')[0];\nconst capStr = adjustDaysUTC(nowUTC.toISOString(), -MAX_LOOKBACK_DAYS);\n\nlet feedsSince = null;\nlet feedsWindowCapped = false;\nlet feedsSource = 'fallback';\nlet debugError = null; \nlet foundBriefingPath = null; \n\n// ── 1. Fetch previous briefing ───────────────────────────────────────────────────────\ntry {\n  const listResp = await this.helpers.httpRequest({\n    method: 'GET',\n    url: `${BASE}/vault/Overview/`,\n    skipSslCertificateValidation: true,\n    headers: {\n      'Authorization': `Bearer ${API_KEY}`,\n      'Accept': 'application/json'\n    }\n  });\n\n  const files = Array.isArray(listResp) ? listResp : (listResp.files || []);\n  \n  const briefingRegex = /(?:Overview\\/)?(\\d{4}-\\d{2}-\\d{2}) - Daily Briefing\\.md$/;\n  \n  const prev = files\n    .map(f => {\n      const path = typeof f === 'object' ? (f.path || f.name) : f;\n      const m = path.match(briefingRegex);\n      return m ? { path: path, date: m[1] } : null;\n    })\n    .filter(Boolean)\n    .filter(b => b.date < todayStr)\n    .sort((a, b) => b.date.localeCompare(a.date))[0];\n\n  if (prev) {\n    foundBriefingPath = prev.path;\n    \n    // Ensure the path includes 'Overview/' so we don't 404 at the root of the vault\n    let filePathToFetch = prev.path;\n    if (!filePathToFetch.startsWith('Overview/')) {\n      filePathToFetch = 'Overview/' + filePathToFetch;\n    }\n    \n    const encodedPath = filePathToFetch.split('/').map(encodeURIComponent).join('/');\n\n    const briefResp = await this.helpers.httpRequest({\n      method: 'GET',\n      url: `${BASE}/vault/${encodedPath}`,\n      skipSslCertificateValidation: true,\n      headers: {\n        'Authorization': `Bearer ${API_KEY}`,\n        'Accept': 'text/markdown'\n      }\n    });\n\n    const content = typeof briefResp === 'string' ? briefResp : (briefResp.content || '');\n    const ga = extractGeneratedAt(content);\n    \n    if (ga) {\n      feedsSince = adjustMinutesUTC(ga, -FEED_BUFFER_MINS);\n      feedsSource = 'briefing-frontmatter';\n    } else {\n      debugError = \"File fetched, but generated_at regex failed to find a match.\";\n    }\n  } else {\n      debugError = \"No files matched the regex and date filter.\";\n  }\n} catch (e) { \n  console.warn('Failed to fetch previous briefing:', e.message); \n  debugError = e.message; \n}\n\n// ── 2. Fallback: 24h ago ──────────────────────────────────────────────────────────────\nif (!feedsSince) { \n  feedsSince = adjustMinutesUTC(nowUTC.toISOString(), -1440); \n}\n\n// ── 3. Apply 7-day cap ────────────────────────────────────────────────────────────────\nif (feedsSince < capStr) {\n  feedsSince = capStr;\n  feedsWindowCapped = true;\n}\n\n// ── 4. Derived values ────────────────────────────────────────────────────────────────\nreturn [{ json: {\n  shared_date: todayStr,\n  feedsSince,\n  feedsSinceUnix: Math.floor(new Date(feedsSince).getTime() / 1000),\n  feedsSinceGmailDate: feedsSince.substring(0, 10).replace(/-/g, '/'),\n  feedsWindowCapped,\n  feedsWindowCapMessage: feedsWindowCapped ? 'Feed window capped at 7 days.' : null,\n  feedsSource,\n  feedBufferMins: FEED_BUFFER_MINS,\n  debugError,           \n  foundBriefingPath     \n} }];"
      },
