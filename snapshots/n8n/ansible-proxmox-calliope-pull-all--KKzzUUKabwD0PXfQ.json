    {
      "parameters": {
        "jsCode": "const output = $json.stdout;\n\n// Extract PLAY RECAP section\nconst recapMatch = output.match(/PLAY RECAP[\\s\\S]*$/);\n\nif (!recapMatch) {\n  return [{ message: \"No recap found. Check Ansible output.\" }];\n}\n\nconst recap = recapMatch[0];\n\n// Extract each host line\nconst lines = recap.split(\"\\n\").filter(line => line.includes(\":\"));\n\nlet summary = [];\nlet hasFailure = false;\n\nfor (const line of lines) {\n  const match = line.match(/^(\\S+)\\s+:.*ok=(\\d+).*changed=(\\d+).*failed=(\\d+)/);\n  if (match) {\n    const [, host, ok, changed, failed] = match;\n\n    if (failed !== \"0\") hasFailure = true;\n\n    summary.push(\n      `${host}: ok=${ok}, changed=${changed}, failed=${failed}`\n    );\n  }\n}\n\nreturn [{\n  message: (hasFailure ? \"❌ Ansible PULL ALL FAILED\\n\" : \"✅ Ansible PULL ALL OK\\n\") + summary.join(\"\\n\")\n}];"
      },
