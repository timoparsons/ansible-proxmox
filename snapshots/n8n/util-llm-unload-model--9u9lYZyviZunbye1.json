    {
      "parameters": {
        "jsCode": "const allModels = items[0].json.models;\nconst desiredModel = $('When Executed by Another Workflow').first().json.manualModelName || null;\n\nlet instancesToUnload = [];\n\nfor (const model of allModels) {\n  if (model.loaded_instances && model.loaded_instances.length > 0) {\n    if (desiredModel && model.key === desiredModel) {\n      continue;\n    }\n    for (const instance of model.loaded_instances) {\n      instancesToUnload.push({ instance_id: instance.id });\n    }\n  }\n}\n\nif (instancesToUnload.length === 0) {\n  return [{ json: { action: 'skipped', reason: desiredModel ? 'correct model already loaded' : 'no models loaded', hasWork: false } }];\n}\n\nreturn instancesToUnload.map(i => ({ json: { ...i, hasWork: true } }));"
      },
