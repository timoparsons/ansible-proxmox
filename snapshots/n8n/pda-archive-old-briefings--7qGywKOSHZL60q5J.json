    {
      "name": "Filter Briefings to Archive",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "jsCode": "const files = $input.first().json.files;\n\nconst briefings = files\n  .map(f => f.replace(/\\.md$/, ''))\n  .filter(f => f.match(/^\\d{4}-\\d{2}-\\d{2}( \\d{2}:\\d{2})? - Daily Briefing$/))\n  .sort();\n\nconst toArchive = briefings.slice(0, -1);\n\nreturn toArchive.map(filename => ({ json: { filename } }));"
      },
      "position": [
        -192,
        0
      ],
      "typeVersion": 2,
      "id": "9ef3c37e-cf78-4fdb-be83-93a1e9046aab"
    },
