      "id": "node-http",
      "name": "Call LM Studio",
      "position": [
        896,
        304
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item;\nconst rawText = item.json.choices?.[0]?.message?.content ?? '';\nconst cleaned = rawText.replace(/^```json\\s*/i, '').replace(/\\s*```$/i, '').trim();\n\n// Carry all upstream context through\nconst filePath    = $('Build Prompt').item.json.filePath;\nconst filename    = $('Build Prompt').item.json.filename;\nconst fileType    = $('Build Prompt').item.json.fileType;\nconst origContent = $('Build Prompt').item.json.content;\nconst changed     = $('Build Prompt').item.json.changed ?? false;\nconst fixes       = [...($('Build Prompt').item.json.fixes ?? [])];\nconst flags       = [...($('Build Prompt').item.json.flags ?? [])];\nconst writeStatus = $('Build Prompt').item.json.writeStatus ?? 'skipped';\n\nlet llmContent = origContent;\nlet llmFixes   = [];\nlet llmFlags   = [];\nlet llmError   = null;\nlet llmChanged = false;\n\ntry {\n  const parsed = JSON.parse(cleaned);\n  if (!parsed.content || parsed.content.trim() === '') {\n    llmError = 'LLM returned empty content — original preserved';\n    flags.push(llmError);\n  } else {\n    llmContent = parsed.content;\n    llmFixes   = Array.isArray(parsed.fixes) ? parsed.fixes : [];\n    llmFlags   = Array.isArray(parsed.flags) ? parsed.flags : [];\n    llmChanged = llmContent !== origContent;\n  }\n} catch (err) {\n  llmError = `Failed to parse LLM response: ${err.message}`;\n  flags.push(llmError);\n}\n\nreturn [{ json: {\n  filePath, filename, fileType,\n  content:     llmChanged ? llmContent : origContent,\n  changed:     changed || llmChanged,\n  fixes:       [...fixes, ...llmFixes],\n  flags:       [...flags, ...llmFlags],\n  writeStatus,\n  llmSkipped:  false,\n  llmChanged,\n  llmError\n}}];"
      },
