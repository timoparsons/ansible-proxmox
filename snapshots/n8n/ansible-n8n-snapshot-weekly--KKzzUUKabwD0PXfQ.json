    {
      "id": "58c7b239-6e6a-438c-b4cd-8b15799cb1ff",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "parameters": {
        "jsCode": "const output = $json.stdout || '';\nconst parts = output.split('PLAY RECAP').slice(1);\n\nif (parts.length === 0) {\n  return [{ message: \"No recap found. Check Ansible output.\\n\" + (($json.stderr || '').slice(0, 300)) }];\n}\n\nconst labels = ['n8n snapshot', 'config snapshot'];\nlet hasFailure = false;\nconst text = [];\n\nparts.forEach((recap, i) => {\n  const bad = [];\n  for (const line of recap.split(\"\\n\")) {\n    const m = line.match(/^(\\S+)\\s+:.*unreachable=(\\d+).*failed=(\\d+)/);\n    if (m && (m[2] !== \"0\" || m[3] !== \"0\")) bad.push(`${m[1]}: failed=${m[3]}, unreachable=${m[2]}`);\n  }\n  if (bad.length) hasFailure = true;\n  text.push((bad.length ? \"❌ \" : \"✅ \") + (labels[i] || 'run ' + (i + 1)) + (bad.length ? \" FAILED\\n\" + bad.join(\"\\n\") : \" OK\"));\n});\n\nif (parts.length < labels.length) {\n  hasFailure = true;\n  text.push(\"❌ config snapshot did not run\");\n}\n\ntext.push(output.includes(\"No workflow changed\") ? \"n8n: no workflow changes since the last snapshot.\" : (output.includes(\"TASK [Push]\") ? \"n8n: new snapshot committed and pushed.\" : \"\"));\ntext.push(output.includes(\"No config changed since the last snapshot\") ? \"configs: no changes since the last snapshot.\" : (output.includes(\"TASK [Commit]\") ? \"configs: new snapshot committed and pushed.\" : \"\"));\n\nreturn [{ message: (hasFailure ? \"❌ Ansible snapshots had problems\\n\" : \"✅ Ansible snapshots OK\\n\") + text.filter(t => t).join(\"\\n\") }];"
      }
    },
