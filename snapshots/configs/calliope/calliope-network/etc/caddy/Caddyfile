# Global options
{
    #auto_https off
}

# Core Services

unifi.timparsons.nz {
    tls internal
    reverse_proxy https://10.1.1.1 {
        transport http {
            tls_insecure_skip_verify
        }
        header_up Host 10.1.1.1
        header_up Origin https://10.1.1.1
    }
}

proxmox.timparsons.nz {
    tls internal
    reverse_proxy https://10.1.1.20:8006 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

