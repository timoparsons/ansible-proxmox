                            "style": "ha-card {\n  --chip-icon-size: calc(var(--icon-size) + 2px); !important;\n  --chip-height: var(--chip-size) !important;\n  margin-top: var(--top_margin) !important;\n  padding: 0 !important;\n  aspect-ratio: 1 !important;\n  border-radius: 50% !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  {% if is_state(config.entity, 'on') %}\n    --color: var(--yellow-color);\n  {% else %}\n    --color: var(--disabled-color);\n  {% endif %}\n}\n"
                          }
                        },
                        {
                          "type": "template",
                          "entity": "alarm_control_panel.crow_alarm_system_alarm",
                          "content_info": "none",
                          "icon": "{% if is_state(config.entity, 'disarmed') %}\n  mdi:shield-off\n{% elif is_state(config.entity, 'armed_away') %}\n  mdi:shield-lock\n{% else %}\n  mdi:shield-alert\n{% endif %}",
                          "card_mod": {
                            "style": "ha-card {\n  --chip-icon-size: calc(var(--icon-size) - 3px); !important;\n  --chip-height: var(--chip-size) !important;\n  margin-top: var(--top_margin) !important;\n  padding: 0 !important;\n  aspect-ratio: 1 !important;\n  border-radius: 50% !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  {% if is_state(config.entity, 'disarmed') %}\n    --color: var(--blue-color);\n  {% elif is_state(config.entity, 'armed_away') %}\n    --color: var(--green-color);\n  {% else %}\n    --color: var(--red-color);\n  {% endif %}\n}\n"
                          }
                        },
