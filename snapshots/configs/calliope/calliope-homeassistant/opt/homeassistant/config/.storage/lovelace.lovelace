                      }
                    },
                    {
                      "type": "custom:mushroom-template-card",
                      "primary": "Start",
                      "secondary": "",
                      "icon": "mdi:timer-outline",
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "timer.start",
                        "target": {
                          "entity_id": [
                            "timer.dogwalk_timer"
                          ]
                        }
                      },
                      "entity": "timer.dogwalk_timer",
                      "color": "{% if is_state(entity,'active') %}\n  grey\n{% else %}\n  green\n{% endif %}",
                      "features_position": "bottom",
                      "grid_options": {
                        "columns": 6,
                        "rows": "auto"
                      }
