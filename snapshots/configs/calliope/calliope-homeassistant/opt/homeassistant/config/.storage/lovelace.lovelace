                        }
                      }
                    ]
                  }
                },
                {
                  "type": "custom:decluttering-template",
                  "template": "smoke_alarm",
                  "card": {
                    "type": "custom:mod-card",
                    "style": {
                      "hui-horizontal-stack-card$": ".card-header {\n  font-size: 15px !important;\n  height: 20px !important;\n  margin-top: 0 !important;\n  padding-top: 0 !important;\n}\n.entities .name {\n  font-size: 10px !important;\n}\n"
                    },
                    "card": {
                      "type": "horizontal-stack",
                      "title": "",
                      "cards": [
                        {
                          "type": "custom:button-card",
                          "entity": "[[entity]]",
                          "tap_action": {
                            "action": "navigate",
                            "navigation_path": "#smoke_detectors"
                          },
                          "hold_action": {
                            "action": "more-info"
                          },
                          "show_name": false,
                          "show_icon": true,
                          "show_state": true,
                          "show_label": false,
                          "icon": "mdi:fire-off",
                          "size": "40px",
                          "state_display": "[[[ \n  if (entity.state === 'on') {\n    return entity.entity_id.split('.')[1].split('_')[1].charAt(0).toUpperCase() + entity.entity_id.split('.')[1].split('_')[1].slice(1) + \": Smoke DETECTED\" ;\n  } else {\n    return entity.entity_id.split('.')[1].split('_')[1].charAt(0).toUpperCase() + entity.entity_id.split('.')[1].split('_')[1].slice(1) + \": Smoke CLEAR\";\n  }\n]]]\n",
                          "styles": {
                            "card": [
                              {
                                "height": "76px"
                              },
                              {
                                "font-size": "12px"
                              },
                              {
                                "display": "[[[ return entity.state === 'on' ? 'block' : 'none'; ]]]\n"
                              }
                            ],
                            "icon": [
                              {
                                "height": "30px"
                              },
                              {
                                "padding": "13px"
                              },
                              {
                                "color": "grey"
                              }
                            ]
                          },
                          "state": [
                            {
                              "value": "on",
                              "color": "red",
                              "icon": "mdi:fire-alert",
                              "styles": {
                                "card": [
                                  {
                                    "animation": "blink 2s ease infinite"
                                  }
                                ],
                                "state": [
                                  {
                                    "color": "white"
                                  }
                                ],
                                "name": [
                                  {
                                    "color": "white"
                                  }
                                ],
                                "icon": [
                                  {
                                    "color": "white"
                                  }
                                ]
                              }
                            },
                            {
                              "value": "off"
                            }
                          ],
                          "color_type": "card"
                        }
                      ]
                    }
                  },
                  "default": [
                    {
                      "entity": "binary_sensor.smoke_office_smoke"
                    }
                  ]
                }
              ],
              "column_span": 1
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:decluttering-card",
                  "template": "nav_bar_card_new"
                }
              ]
            }
          ],
          "max_columns": 1,
          "cards": []
        }
      ]
    }
  }
}
