                          "icon": "{% if is_state(config.entity, 'on') %}\n  mdi:door-open\n{% else %}\n  mdi:door-closed\n{% endif %}",
                          "content_info": "none",
                          "card_mod": {
                            "style": "ha-card {\n  --chip-icon-size: calc(var(--icon-size) + 0px); !important;\n  --chip-height: var(--chip-size) !important;\n  margin-top: var(--top_margin) !important;\n  padding: 0 !important;\n  aspect-ratio: 1 !important;\n  border-radius: 50% !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  {% if is_state(config.entity, 'on') and is_state('group.persons', 'off') %}\n    --color: var(--red-color);\n  {% elif is_state(config.entity, 'on') %}\n    --color: var(--yellow-color);\n  {% else %}\n    --color: var(--disabled-color);\n  {% endif %}\n}\n"
                          }
