                    {
                      "off_label": "Closed"
                    },
                    {
                      "off_color": "#0366d6"
                    },
                    {
                      "on_label": "Open"
                    },
                    {
                      "on_color": "#0366d6"
                    }
                  ]
                },
                {
                  "type": "custom:decluttering-template",
                  "template": "lxc_service_button",
                  "card": {
                    "type": "custom:bubble-card",
                    "card_type": "button",
                    "entity": "[[entity]]",
                    "show_state": true,
                    "show_last_changed": false,
                    "show_attribute": false,
                    "force_icon": false,
                    "name": "[[name]]",
                    "sub_button": [
                      {
                        "entity": "[[lxc_cpu]]",
                        "icon": "mdi:cpu-64-bit",
                        "name": "CPU",
                        "unit": "%",
                        "show_state": true,
                        "show_name": true,
                        "show_icon": false
                      },
                      {
                        "entity": "script.lxc_restart",
                        "name": "Reboot",
                        "icon": "mdi:restart",
                        "tap_action": {
                          "action": "call-REDACTED,
                          "REDACTED: "script.backend_restart_lxc_container",
                          "data": {
                            "lxc_name": "[[lxc_name]]"
                          }
                        }
                      },
                      {
                        "entity": "script.lxc_toggle",
                        "name": "Power",
                        "icon": "mdi:power",
                        "tap_action": {
                          "action": "call-REDACTED,
                          "REDACTED: "script.backend_toggle_lxc_container",
                          "data": {
                            "lxc_name": "[[lxc_name]]"
                          }
                        }
                      }
                    ],
                    "card_layout": "large",
                    "grid_options": {
                      "columns": "full",
                      "rows": 1
                    },
                    "show_icon": true,
                    "scrolling_effect": false,
                    "icon": "[[icon]]",
                    "button_action": {
                      "tap_action": {
                        "action": "more-info"
                      }
                    },
                    "button_type": "switch",
                    "styles": ".bubble-button-background {\n  background: var(--card-background-color) !important;\n}\n.bubble-sub-button {\n  background-color: var(--card-background-color) !important;\n}\n"
                  },
                  "default": [
                    {
                      "name": "Jellyfin"
                    },
                    {
                      "lxc_name": "jellyfin_143"
                    },
                    {
                      "icon": "mdi:jellyfish-outline"
                    },
                    {
                      "entity": "binary_sensor.lxc_jellyfin_143_status"
                    },
                    {
                      "lxc_cpu": "sensor.lxc_jellyfin_143_cpu_used"
                    },
                    {
                      "lxc_reboot": "button.lxc_jellyfin_143_reboot"
                    }
                  ],
                  "grid_options": {
                    "columns": 12,
                    "rows": "auto"
                  }
                },
                {
                  "type": "custom:decluttering-template",
                  "template": "templated_mini_graph_numeric",
                  "card": {
                    "type": "custom:config-template-card",
                    "variables": {
                      "HOURS": "states['input_number.minigraph_hours_to_show'].state",
                      "POINTS": "states['input_number.minigraph_points_per_hour'].state"
                    },
                    "entities": [
                      "[[hours_entity]]",
                      "[[points_entity]]"
                    ],
                    "card": {
                      "type": "custom:mini-graph-card",
                      "name": "[[card_name]]",
                      "icon": "[[icon]]",
                      "entities": "[[graph_entities]]",
                      "state_map": [
                        {
                          "value": "0",
                          "label": "[[off_label]]"
                        },
                        {
                          "value": "1",
                          "label": "[[on_label]]"
                        }
                      ],
                      "hours_to_show": "${HOURS}",
                      "points_per_hour": "${POINTS}",
                      "line_width": 2,
                      "font_size": 75,
                      "animate": true,
                      "smoothing": false,
                      "show": {
                        "name": true,
                        "icon": true,
                        "state": true,
                        "legend": false
                      },
                      "color_thresholds": [
                        {
                          "value": 0,
                          "color": "[[off_color]]"
                        },
                        {
                          "value": 1,
                          "color": "[[on_color]]"
                        }
                      ]
                    }
                  },
                  "default": [
                    {
                      "hours_entity": "input_number.minigraph_hours_to_show"
                    },
                    {
                      "points_entity": "input_number.minigraph_points_per_hour"
                    },
                    {
                      "card_name": "Door"
                    },
                    {
                      "icon": "mdi:toggle-switch"
                    },
                    {
                      "graph_entities": [
                        {
                          "entity": "sensor.door_bathroom_numeric",
