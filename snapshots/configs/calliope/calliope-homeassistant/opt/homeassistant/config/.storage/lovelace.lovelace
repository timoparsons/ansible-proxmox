                    "type": "custom:config-template-card",
                    "variables": {
                      "HOURS": "states['[[hours_entity]]'].state",
                      "POINTS": "states['[[points_entity]]'].state"
                    },
                    "entities": [
                      "[[hours_entity]]",
                      "[[points_entity]]"
                    ],
                    "card": {
                      "type": "custom:mini-graph-card",
                      "name": "[[card_name]]",
                      "icon": "[[icon]]",
                      "entities": "[[graph_entities]]",
                      "state_map": [
                        {
                          "value": "off",
                          "label": "[[off_label]]"
                        },
                        {
                          "value": "on",
                          "label": "[[on_label]]"
                        }
                      ],
                      "hours_to_show": "${HOURS}",
                      "points_per_hour": "${POINTS}",
                      "line_width": 2,
                      "font_size": 75,
                      "animate": true,
                      "smoothing": false,
                      "show": {
                        "name": true,
                        "icon": true,
                        "state": true,
                        "legend": false
                      },
                      "color_thresholds": [
                        {
                          "value": 0,
                          "color": "[[off_color]]"
                        },
                        {
                          "value": 1,
                          "color": "[[on_color]]"
                        }
                      ]
                    }
                  },
                  "default": [
                    {
                      "hours_entity": "input_number.minigraph_hours_to_show"
                    },
                    {
                      "points_entity": "input_number.minigraph_points_per_hour"
                    },
                    {
