{
  "version": 1,
  "minor_version": 1,
  "key": "REDACTED",
  "data": {
    "config": {
      "title": "Calliope",
      "kiosk_mode": {
        "hide_sidebar": true,
        "hide_header": true,
        "user_settings": [
          {
            "users": [
              "tim"
            ],
            "hide_sidebar": "[[[ !is_state(\"input_boolean.sidebar_toggle\", \"on\") ]]]",
            "hide_header": "[[[ !is_state(\"input_boolean.sidebar_toggle\", \"on\") ]]]"
          }
        ]
      },
      "button_card_templates": {
        "button-card-presence": {
          "type": "custom:button-card",
          "entity": "[[[ return entity.entity_id ]]]",
          "icon": "[[[ \n  return entity.state === 'home' ? 'mdi:home' : 'mdi:arrow-right-bold';\n]]]\n",
          "show_name": false,
          "show_state": false,
          "show_icon": true,
          "styles": {
            "card": [
              {
                "width": "15px"
              },
              {
                "height": "15px"
              },
              {
                "border-radius": "50%"
              },
              {
                "margin-left": "-18px"
              },
              {
                "border": "none"
              }
            ],
            "img_cell": [
              {
                "background-color": "[[[\n  return entity.state === 'home' ? 'green' : 'grey';\n]]]\n"
              }
            ],
            "icon": [
              {
                "width": "80%"
              },
              {
                "align-self": "center"
              },
              {
                "justify-self": "center"
              },
              {
                "padding": "0px 0px 0px 0px"
              },
              {
                "color": "light-gray"
              }
            ]
          }
        },
        "motion_bubble": {
          "variables": {
            "var_entity": "entity",
            "var_icon_on": "icon",
            "var_icon_off": "icon"
          },
          "type": "custom:button-card",
          "icon": "[[[ return variables.var_icon_off]]]",
          "entity": "[[[ return variables.var_entity]]]",
          "show_name": false,
          "show_label": true,
          "state": [
            {
              "value": "on",
              "icon": "[[[ return variables.var_icon_on]]]",
              "styles": {
                "card": null,
                "icon": [
                  {
                    "color": "rgba(255,255,255,1)"
                  }
                ],
                "label": [
                  {
                    "color": "rgba(255,255,255,1)"
                  }
                ]
              }
            }
          ],
          "styles": {
            "card": [
              {
                "border-radius": "100px",
                "width": "60px",
                "height": "60px",
                "background-color": "rgba(255, 255, 255, 0.1)",
                "margin-top": "8px",
                "margin-left": "4px"
              }
            ],
            "icon": [
              {
                "width": "19px",
                "padding-top": "2px",
                "color": "rgba(255,255,255,0.5)"
              }
            ],
            "label": [
              {
                "padding-bottom": "10px",
                "font-size": "10px",
                "font-weight": "bold",
                "color": "rgba(255,255,255,0.5)",
                "letter-spacing": "-.4px",
                "-webkit-backdrop-filter": "blur(10px); !important;"
              }
            ]
          },
          "card_mod": null,
          "style": "ha-card {\n-webkit-backdrop-filter: blur(10px); !important;\n}\n"
        },
        "first_subheading": {
          "variables": {
            "var_device": "device"
          },
          "type": "custom:button-card",
          "name": "[[[ return variables.var_device]]]",
          "styles": {
            "grid": [
              {
                "grid-template-areas": "\"n\""
              }
            ],
            "card": [
              {
                "background": "transparent"
              },
              {
                "height": "40px"
              },
              {
                "border-radius": "0px"
              },
              {
                "margin-top": "20px"
              },
              {
                "margin-bottom": "0px"
              },
              {
                "margin-left": "15px"
              }
            ],
            "name": [
              {
                "justify-self": "start"
              },
              {
                "font-size": "18px"
              },
              {
                "font-weight": 500
              },
              {
                "color": "var(--primary-text-color)"
              },
              {
                "font-weight": "bold"
              }
            ]
          },
          "show_state": false,
          "show_name": true,
          "show_icon": false,
          "layout_options": {
            "grid_columns": 4,
            "grid_rows": 1.2
          }
        },
        "lights_bubble": {
          "variables": {
            "var_entity": "entity",
            "var_icon": "icon"
          },
          "type": "custom:button-card",
          "icon": "mdi:lightbulb-on",
          "entity": "[[[ return variables.var_entity]]]",
          "show_name": false,
          "show_label": true,
          "state": [
            {
              "value": "on",
              "icon": "mdi:lightbulb-on",
              "styles": {
                "card": null,
                "icon": [
                  {
                    "color": "gold"
                  }
                ],
                "label": [
                  {
                    "color": "rgba(255,255,255,1)"
                  }
                ]
              }
            }
          ],
          "styles": {
            "card": [
              {
                "border-radius": "100px",
                "width": "60px",
                "height": "60px",
                "background-color": "rgba(255, 255, 255, 0.1)",
                "margin-top": "8px",
                "margin-left": "4px"
              }
            ],
            "icon": [
              {
                "width": "19px",
                "padding-top": "2px",
                "color": "rgba(255,255,255,0.5)"
              }
            ],
            "label": [
              {
                "padding-bottom": "10px",
                "font-size": "10px",
                "font-weight": "bold",
                "color": "rgba(255,255,255,0.5)",
                "letter-spacing": "-.4px",
                "-webkit-backdrop-filter": "blur(10px); !important;"
              }
            ]
          },
          "card_mod": null,
          "style": "ha-card {\n-webkit-backdrop-filter: blur(10px); !important;\n}\n"
        }
      },
      "views": [
        {
          "title": "home",
          "path": "home",
          "icon": "mdi:home",
          "type": "sections",
          "max_columns": 1,
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:decluttering-card",
                  "template": "nav_bar_card_new"
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:layout-card",
                  "layout_type": "custom:grid-layout",
                  "cards": [
                    {
                      "type": "custom:decluttering-card",
                      "template": "page_heading"
                    },
                    {
                      "type": "custom:gap-card"
                    },
                    {
                      "type": "custom:decluttering-card",
                      "template": "person_chip",
                      "variables": [
                        {
                          "letter": "T"
                        },
                        {
                          "entity": "person.tim"
                        },
                        {
                          "action": "navigate"
                        },
                        {
                          "navigation_path": "#dogwalk"
                        }
                      ]
                    },
                    {
                      "type": "custom:decluttering-card",
                      "template": "person_chip",
                      "variables": [
                        {
                          "letter": "S"
                        },
                        {
                          "entity": "person.sonya"
                        }
                      ]
                    },
                    {
                      "type": "custom:decluttering-card",
                      "template": "person_chip",
                      "variables": [
                        {
                          "letter": "C"
                        },
                        {
                          "entity": "person.celeste"
                        }
                      ]
                    },
                    {
                      "type": "custom:decluttering-card",
                      "template": "person_chip",
                      "variables": [
                        {
                          "letter": "E"
                        },
                        {
                          "entity": "person.eve"
                        }
                      ]
                    }
                  ],
                  "style": null,
                  "layout_options": {
                    "grid_columns": 4
                  },
                  "layout": {
                    "grid-template-columns": "auto 1fr repeat(4, 32px)",
                    "grid-template-rows": "min-content",
                    "grid-template-areas": "\"title gap one two three four \"",
                    "margin": "20px 4px -10px 6px",
                    "padding": "0px 0px 10px 0px"
                  }
                },
                {
                  "type": "custom:mushroom-chips-card",
                  "alignment": "start",
                  "chips": [
                    {
                      "type": "weather",
                      "entity": "weather.metservice_north_shore",
                      "tap_action": {
                        "action": "navigate",
                        "navigation_path": "#weather"
                      },
                      "show_conditions": false,
                      "show_temperature": true,
                      "card_mod": {
                        "style": "ha-card {\n  justify-content: center;\n  --chip-icon-size: var(--icon-size) !important;\n  --chip-height: var(--chip-size) !important;\n  border-radius: 2em !important;\n}\n"
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "person.tim",
                          "state_not": "City"
                        }
                      ],
                      "chip": {
                        "type": "template",
                        "tap_action": {
                          "action": "navigate",
                          "navigation_path": "#ferries"
                        },
                        "icon_color": "{% set time = states('sensor.devonport_downtown_next_1') | as_timestamp %} {% set now = now() | as_timestamp %} {% set diff_mins = ((time - now) / 60) | round(0) %} {% if diff_mins < 5 %}\n  red\n{% elif diff_mins < 15 %}\n  orange\n{% else %}\n  light-blue\n{% endif %}",
                        "icon": "mdi:ferry",
                        "entity": "sensor.devonport_downtown_next_1_relative",
                        "content": "{{ states('sensor.devonport_downtown_next_1_relative')}}",
                        "card_mod": {
                          "style": "ha-card {\n  justify-content: center;\n  --chip-icon-size: var(--icon-size) !important;\n  --chip-height: var(--chip-size) !important;\n  border-radius: 2em !important;\n}\n"
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "person.tim",
                          "state": "City"
                        }
                      ],
                      "chip": {
                        "type": "template",
                        "tap_action": {
                          "action": "navigate",
                          "navigation_path": "#ferries"
                        },
                        "icon_color": "{% set time = states('sensor.downtown_devonport_next_1') | as_timestamp %} {% set now = now() | as_timestamp %} {% set diff_mins = ((time - now) / 60) | round(0) %} {% if diff_mins < 5 %}\n  red\n{% elif diff_mins < 15 %}\n  orange\n{% else %}\n  light-blue\n{% endif %}",
                        "icon": "mdi:ferry",
                        "entity": "sensor.downtown_devonport_next_1_relative",
                        "content": "{{ states('sensor.downtown_devonport_next_1_relative')}}",
                        "card_mod": {
                          "style": "ha-card {\n  justify-content: center;\n  --chip-icon-size: var(--icon-size) !important;\n  --chip-height: var(--chip-size) !important;\n  border-radius: 2em !important;\n}\n"
                        }
                      }
                    },
                    {
                      "type": "template",
                      "entity": "sensor.waste_collection_schedule_rubbish",
                      "tap_action": {
                        "action": "none"
                      },
                      "icon": "{% set ns = namespace(items=[]) %} {% for ent in ['sensor.waste_collection_schedule_recycling', 'sensor.waste_collection_schedule_rubbish'] %}\n  {% for k, v in states[ent].attributes.items() %}\n    {% if k not in ['attribution', 'icon', 'friendly_name'] %}\n      {% set ns.items = ns.items + [{'type': v, 'date': k}] %}\n    {% endif %}\n  {% endfor %}\n{% endfor %} {% if ns.items | length > 0 %}\n  {% set min_date = ns.items | map(attribute='date') | list | sort | first %}\n  {% set types = ns.items | selectattr('date', 'equalto', min_date) | map(attribute='type') | list | join(' ') | lower %}\n  {% if 'recycl' in types %}\n    mdi:recycle\n  {% else %}\n    mdi:trash-can\n  {% endif %}\n{% else %}\n  mdi:help-rhombus\n{% endif %}\n",
                      "icon_color": "{% set ns = namespace(items=[]) %} {% for ent in ['sensor.waste_collection_schedule_recycling', 'sensor.waste_collection_schedule_rubbish'] %}\n  {% for k in states[ent].attributes.keys() %}\n    {% if k not in ['attribution', 'icon', 'friendly_name'] %}\n      {% set ns.items = ns.items + [k] %}\n    {% endif %}\n  {% endfor %}\n{% endfor %} {% if ns.items | length > 0 %}\n  {% set min_date = ns.items | sort | first %}\n  {% set days = (as_datetime(min_date).date() - now().date()).days %}\n  {% if days == 1 %}\n    red\n  {% elif days <= 0 %}\n    orange\n  {% else %}\n    light-blue\n  {% endif %}\n{% else %}\n  grey\n{% endif %}\n",
                      "content": "{% set ns = namespace(items=[]) %} {% for ent in ['sensor.waste_collection_schedule_recycling', 'sensor.waste_collection_schedule_rubbish'] %}\n  {% for k in states[ent].attributes.keys() %}\n    {% if k not in ['attribution', 'icon', 'friendly_name'] %}\n      {% set ns.items = ns.items + [k] %}\n    {% endif %}\n  {% endfor %}\n{% endfor %} {% if ns.items | length > 0 %}\n  {% set min_date = ns.items | sort | first %}\n  {% set dt = as_datetime(min_date) %}\n  {% set days = (dt.date() - now().date()).days %}\n  {% if days <= 0 %}\n    Today\n  {% elif days == 1 %}\n    Tomorrow\n  {% else %}\n    {{ dt.strftime('%a') }} {{ dt.day }}\n  {% endif %}\n{% else %}\n  No data\n{% endif %}\n",
                      "card_mod": {
                        "style": "ha-card {\n  justify-content: center;\n  --chip-icon-size: var(--icon-size) !important;\n  --chip-height: var(--chip-size) !important;\n  border-radius: 2em !important;\n}\n"
                      }
                    },
                    {
                      "type": "template",
                      "entity": "sensor.bosch_dishwasher_operation_state",
                      "tap_action": {
                        "action": "navigate",
                        "navigation_path": "#dishwasher"
                      },
                      "icon": "{% set state = states('sensor.bosch_dishwasher_operation_state') %} {% if state == 'Run' %}\n  mdi:dishwasher\n{% elif state == 'Ready' and\n  as_timestamp(states('input_datetime.dishwasher_last_completed'), 0) >\n  as_timestamp(now().replace(hour=0, minute=0, second=0, microsecond=0)) %}\n  mdi:check-circle\n{% else %}\n  mdi:dishwasher-alert\n{% endif %}\n",
                      "icon_color": "{% set state = states('sensor.bosch_dishwasher_operation_state') %} {% if state == 'Run' %}\n  blue\n{% elif state == 'Ready' and\n  as_timestamp(states('input_datetime.dishwasher_last_completed'), 0) >\n  as_timestamp(now().replace(hour=0, minute=0, second=0, microsecond=0)) %}\n  green\n{% else %}\n  light-blue\n{% endif %}\n",
                      "content": "{% set state = states('sensor.bosch_dishwasher_operation_state') %} {% if state == 'Run' %}\n  {{ states('sensor.bosch_dishwasher_program_progress') | int }}%\n{% elif state == 'Ready' and\n  as_timestamp(states('input_datetime.dishwasher_last_completed'), 0) >\n  as_timestamp(now().replace(hour=0, minute=0, second=0, microsecond=0)) %}\n  {{ as_datetime(states('input_datetime.dishwasher_last_completed')).astimezone(now().tzinfo).strftime('%-I:%M%p') | lower }}\n{% endif %}\n",
                      "card_mod": {
                        "style": "ha-card {\n  justify-content: center;\n  --chip-icon-size: var(--icon-size) !important;\n  --chip-height: var(--chip-size) !important;\n  border-radius: 2em !important;\n}\n"
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "or",
                          "conditions": [
                            {
                              "condition": "state",
                              "entity": "switch.watervalve_vegezone_state",
                              "state": "on"
                            },
                            {
                              "condition": "state",
                              "entity": "input_boolean.irrigation_enable_vegezone",
                              "state": "on"
                            }
                          ]
                        }
                      ],
                      "chip": {
                        "type": "template",
                        "tap_action": {
                          "action": "navigate",
                          "navigation_path": "bathroom"
                        },
                        "icon": "mdi:sprout",
                        "content": "{{ states('sensor.irrigation_nextday_vegezone')}}",
                        "entity": "switch.watervalve_vegezone_state",
                        "icon_color": "{{ 'orange' if states(entity) == 'on' else 'light-blue' }}",
                        "card_mod": {
                          "style": "ha-card {\n  justify-content: center;\n  --chip-icon-size: var(--icon-size) !important;\n  --chip-height: var(--chip-size) !important;\n  border-radius: 2em !important;\n}\n"
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "or",
                          "conditions": [
                            {
                              "condition": "state",
                              "entity": "switch.watervalve_sprayzone_state",
                              "state": "on"
                            },
                            {
                              "condition": "state",
                              "entity": "input_boolean.irrigation_enable_sprayzone",
                              "state": "on"
                            }
                          ]
                        }
                      ],
                      "chip": {
                        "type": "template",
                        "tap_action": {
                          "action": "navigate",
                          "navigation_path": "bathroom"
                        },
                        "icon": "mdi:sprinkler-variant",
                        "content": "{{ states('sensor.irrigation_nextday_sprayzone')}}",
                        "entity": "switch.watervalve_sprayzone_state",
                        "icon_color": "{{ 'orange' if states(entity) == 'on' else 'light-blue' }}",
                        "card_mod": {
                          "style": "ha-card {\n  justify-content: center;\n  --chip-icon-size: var(--icon-size) !important;\n  --chip-height: var(--chip-size) !important;\n  border-radius: 2em !important;\n}\n"
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "or",
                          "conditions": [
                            {
                              "condition": "state",
                              "entity": "switch.watervalve_dripzone_state",
                              "state": "on"
                            },
                            {
                              "condition": "state",
                              "entity": "input_boolean.irrigation_enable_dripzone",
                              "state": "on"
                            }
                          ]
                        }
                      ],
                      "chip": {
                        "type": "template",
                        "tap_action": {
                          "action": "navigate",
                          "navigation_path": "bathroom"
                        },
                        "icon": "mdi:water",
                        "content": "{{ states('sensor.irrigation_nextday_dripzone')}}",
                        "entity": "switch.watervalve_dripzone_state",
                        "icon_color": "{{ 'orange' if states(entity) == 'on' else 'light-blue' }}",
                        "card_mod": {
                          "style": "ha-card {\n  justify-content: center;\n  --chip-icon-size: var(--icon-size) !important;\n  --chip-height: var(--chip-size) !important;\n  border-radius: 2em !important;\n}\n"
                        }
                      }
                    },
                    {
                      "type": "conditional",
                      "conditions": [
                        {
                          "condition": "or",
                          "conditions": [
                            {
                              "condition": "state",
                              "entity": "switch.watervalve_lawnzone_state",
                              "state": "on"
                            },
                            {
                              "condition": "state",
                              "entity": "input_boolean.irrigation_enable_lawnzone",
                              "state": "on"
                            }
                          ]
                        }
                      ],
                      "chip": {
                        "type": "template",
                        "tap_action": {
                          "action": "navigate",
                          "navigation_path": "bathroom"
                        },
                        "icon": "mdi:sprinkler",
                        "content": "{{ states('sensor.irrigation_nextday_lawnzone')}}",
                        "entity": "switch.watervalve_lawnzone_state",
                        "icon_color": "{{ 'orange' if states(entity) == 'on' else 'light-blue' }}",
                        "card_mod": {
                          "style": "ha-card {\n  justify-content: center;\n  --chip-icon-size: var(--icon-size) !important;\n  --chip-height: var(--chip-size) !important;\n  border-radius: 2em !important;\n}\n"
                        }
                      }
                    }
                  ],
                  "layout_options": {
                    "grid_columns": 4
                  },
                  "card_mod": {
                    "style": "ha-card {\n  --chip-size: 42px;\n  --icon-size: 24px;\n}\n.chip-container {\n  flex-wrap: nowrap !important;\n  overflow-x: auto !important;\n  -webkit-overflow-scrolling: touch !important;\n}\n.chip-container > * {\n  flex-shrink: 0 !important;\n  min-width: fit-content !important;\n}\n"
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "or",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "binary_sensor.waterleak_dishwasher_water_leak",
                          "state": "on"
                        },
                        {
                          "condition": "state",
                          "entity": "input_boolean.lovelace_show_detailed_data",
                          "state": "on"
                        }
                      ]
                    }
                  ],
                  "card": {
                    "type": "custom:mod-card",
                    "style": {
                      "hui-horizontal-stack-card$": ".card-header {\n  font-size: 15px !important;\n  height: 20px !important;\n  margin-top: 0 !important;\n  padding-top: 0 !important;\n}\n.entities .name {\n  font-size: 10px !important; /* You can adjust the font size as needed */\n}\n"
                    },
                    "card": {
                      "type": "horizontal-stack",
                      "title": "",
                      "cards": [
                        {
                          "type": "custom:button-card",
                          "name": "Dishwasher Leak Detected",
                          "entity": "binary_sensor.waterleak_dishwasher_water_leak",
                          "tap_action": {
                            "action": "more-info"
                          },
                          "hold_action": {
                            "action": "more-info"
                          },
                          "show_name": true,
                          "show_icon": true,
                          "show_state": false,
                          "show_label": false,
                          "icon": "mdi:water-off",
                          "size": "40px",
                          "styles": {
                            "card": [
                              {
                                "height": "76px"
                              },
                              {
                                "font-size": "12px"
                              }
                            ],
                            "icon": [
                              {
                                "height": "30px"
                              },
                              {
                                "padding": "13px"
                              },
                              {
                                "color": "grey"
                              }
                            ]
                          },
                          "state": [
                            {
                              "value": "on",
                              "color": "red",
                              "icon": "mdi:water-alert",
                              "styles": {
                                "card": [
                                  {
                                    "animation": "blink 2s ease infinite"
                                  }
                                ],
                                "state": [
                                  {
                                    "color": "white"
                                  }
                                ],
                                "name": [
                                  {
                                    "color": "white"
                                  }
                                ],
                                "icon": [
                                  {
                                    "color": "white"
                                  }
                                ]
                              }
                            }
                          ],
                          "color_type": "card"
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "condition": "or",
                      "conditions": [
                        {
                          "condition": "state",
                          "entity": "timer.dogwalk_timer",
                          "state": "active"
                        },
                        {
                          "condition": "state",
                          "entity": "input_boolean.lovelace_show_detailed_data",
                          "state": "on"
                        }
                      ]
                    }
                  ],
                  "card": {
                    "type": "custom:mod-card",
