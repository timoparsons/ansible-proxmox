                      {
                        "type": "custom:mushroom-light-card",
                        "entity": "[[entity]]",
                        "name": "[[name]]",
                        "use_light_color": true,
                        "show_brightness_control": true,
                        "show_color_temp_control": false,
                        "show_color_control": false,
                        "collapsible_controls": false,
                        "tap_action": {
                          "action": "toggle"
                        },
                        "hold_action": {
                          "action": "more-info"
                        },
                        "double_tap_action": {
                          "action": "more-info"
                        },
                        "card_mod": {
                          "style": {
                            "mushroom-light-brightness-control$": {
                              "mushroom-slider$": ".slider {\n  height: [[slider_height]] !important;\n}\n"
                            },
                            ".": "ha-card {\n  height: [[height]] !important;\n  padding-top: [[padding_top]];\n}\n"
                          }
                        }
                      },
                      {
                        "type": "conditional",
                        "conditions": [
                          {
                            "entity": "[[timer_entity]]",
                            "state": "active"
                          }
                        ],
                        "card": {
                          "type": "custom:card-templater",
                          "entities": [
                            "[[entity]]"
                          ],
                          "card": {
                            "type": "custom:timer-bar-card",
                            "entities": [
                              "[[timer_entity]]"
                            ],
                            "bar_direction": "ltr",
                            "invert": true,
                            "state_color": true,
                            "icon": "mdi:lightbulb-outline",
                            "active_icon": "mdi:lightbulb",
                            "bar_foreground_template": "{{ '#%02x%02x%02x' % state_attr('[[entity]]', 'rgb_color') }}",
                            "bar_background": "transparent",
                            "layout": "full_row",
                            "text_width": "0px",
                            "bar_height": "[[bar_height]]",
                            "card_mod": {
                              "style": "ha-card {\n  margin-top: [[margin_top]];\n  margin-left: [[margin_left]];\n} \ntimer-bar-entity-row {\n  height: [[bar_height]]\n}\n"
                            }
                          }
                        }
                      }
                    ]
                  },
                  "default": [
                    {
                      "name": "Light with brightness and timer"
                    },
                    {
                      "height": "90px"
                    },
                    {
                      "padding_top": "30px"
                    },
                    {
                      "slider_height": "10px"
                    },
                    {
                      "bar_height": "5px"
                    },
                    {
                      "margin_top": "-34px"
                    },
                    {
                      "margin_left": "-4px"
                    },
                    {
                      "entity": "light.lounge_lamps"
                    },
                    {
                      "timer_entity": "timer.lounge_lamp_timer"
                    }
                  ]
                },
                {
                  "type": "custom:decluttering-template",
                  "template": "nav_bar_card_new",
                  "card": {
                    "type": "custom:navbar-card",
                    "layout": {
                      "auto_padding": {
                        "enabled": true
                      }
                    },
                    "desktop": {
                      "position": "bottom",
                      "show_labels": false
                    },
                    "mobile": {
                      "mode": "docked",
                      "show_labels": false
                    },
                    "styles": ".navbar.mobile.bottom {\n  height: 80px !important;\n  align-items: flex-start !important;\n  padding-top: 5px !important;\n  background-color: var(--card-background-color);\n}\n.navbar.mobile .icon {\n  --mdc-icon-size: 30px;\n}\n.navbar.mobile {\n  gap: 10px;                \n}\n.navbar.desktop {\n  #gap: 30px;\n  #margin-left: 50px !important;\n}\n.navbar.desktop .icon {\n  #--mdc-icon-size: 38px;\n}\n",
                    "routes": [
                      {
                        "url": "/lovelace/home",
                        "icon": "mdi:home",
                        "icon_color": "gray"
                      },
                      {
                        "url": "/lovelace/lights",
                        "icon": "mdi:lightbulb",
                        "icon_color": "[[[\n  return states['light.all_lights'].state === 'on' ? 'gray' : 'gray';\n]]]\n"
                      },
                      {
                        "url": "/lovelace/bathroom",
                        "icon": "mdi:fan",
                        "icon_color": "[[[\n  return states['switch.bathroom_switches'].state === 'on' ? 'gray' : 'gray';\n]]]\n"
                      },
                      {
                        "url": "/lovelace/entertainment",
                        "icon": "mdi:projector",
                        "icon_color": "gray"
                      },
                      {
                        "url": "/lovelace/music",
                        "icon": "mdi:music",
                        "icon_color": "gray"
                      },
                      {
                        "url": "/lovelace/maint",
                        "icon": "mdi:cog",
                        "icon_color": "gray",
                        "hidden": "[[[ return user.name != \"Tim\" ]]]\n"
                      }
                    ]
                  }
                },
                {
                  "type": "custom:decluttering-template",
                  "template": "templated_mini_graph_temperature",
                  "card": {
                    "type": "custom:config-template-card",
