                  },
                  "cards": [
                    {
                      "type": "custom:bubble-card",
                      "card_type": "separator",
                      "name": "Calliope",
                      "icon": "mdi:nas",
                      "sub_button": {
                        "main": [
                          {
                            "icon": "mdi:restart",
                            "name": "Restart",
                            "show_name": false,
                            "show_icon": true,
                            "show_background": true,
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "button.press",
                              "target": {
                                "entity_id": "button.calliope_restart"
                              },
                              "confirmation": {
                                "text": "Restart Calliope? Everything using its shares will lose access until it is back."
                              }
                            }
                          },
                          {
                            "icon": "mdi:power",
                            "name": "Shut down",
                            "show_name": false,
                            "show_icon": true,
                            "show_background": true,
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "button.press",
                              "target": {
                                "entity_id": "button.calliope_shut_down"
                              },
                              "confirmation": {
                                "text": "Shut down Calliope? It will not come back until power-recovery or someone wakes it."
                              }
                            }
                          }
                        ],
                        "bottom": []
                      },
                      "grid_options": {
                        "columns": 12,
                        "rows": "auto"
                      },
                      "styles": ".bubble-icon { color: ${(() => { const s = hass.states; const g = (e) => s[e] ? s[e].state : 'unavailable'; const t = parseFloat(g('sensor.calliope_temperature')); if (isNaN(t)) return 'var(--disabled-text-color)'; const u = parseFloat(g('sensor.calliope_volume_2_volume_used')) || 0; if (t >= 70 || u >= 90 || g('sensor.calliope_volume_2_status') !== 'normal' || g('binary_sensor.calliope_security_status') === 'on') return 'var(--error-color)'; if (t >= 55 || u >= 80) return 'var(--warning-color)'; return 'var(--success-color)'; })()} !important; } .bubble-name-container { overflow: visible !important; } .bubble-name { font-size: 22px !important; font-weight: 600 !important; line-height: 1.4 !important; overflow: visible !important; } .bubble-icon { --mdc-icon-size: 28px !important; width: 28px !important; height: 28px !important; }"
                    },
                    {
                      "type": "custom:mushroom-template-card",
                      "primary": "{% if has_value('sensor.calliope_temperature') %}CPU {{ states('sensor.calliope_cpu_utilisation_total') | int(0) }}% · RAM {{ states('sensor.calliope_memory_usage_real') | int(0) }}% · {{ states('sensor.calliope_temperature') | int(0) }}°C{% else %}Offline{% endif %}",
                      "secondary": "{% if has_value('sensor.calliope_temperature') %}↑ {{ (states('sensor.calliope_upload_throughput') | float(0) / 1024) | round(1) }} MB/s · ↓ {{ (states('sensor.calliope_download_throughput') | float(0) / 1024) | round(1) }} MB/s\nVolume 2 · {{ states('sensor.calliope_volume_2_volume_used') | float(0) | round(0) | int }}% used ({{ states('sensor.calliope_volume_2_used_space') | float(0) | round(1) }} TB){% else %}Unreachable{% endif %}",
                      "multiline_secondary": true,
                      "fill_container": true,
                      "grid_options": {
                        "columns": 12,
                        "rows": "auto"
                      },
                      "tap_action": {
                        "action": "more-info",
                        "entity": "sensor.calliope_temperature"
                      },
                      "hold_action": {
                        "action": "none"
                      },
                      "double_tap_action": {
                        "action": "none"
                      },
                      "card_mod": {
                        "style": "ha-card { border: none !important; box-shadow: none !important; --ha-card-border-width: 0px; background: transparent !important; margin-top: -24px !important; }"
                      }
                    },
                    {
                      "type": "custom:bubble-card",
                      "card_type": "button",
                      "button_type": "state",
                      "name": "Scrubbing & indexing",
                      "icon": "mdi:harddisk",
                      "tap_action": {
                        "action": "none"
                      },
                      "hold_action": {
                        "action": "none"
                      },
                      "double_tap_action": {
                        "action": "none"
                      },
                      "sub_button": {
                        "main": [
                          {
                            "icon": "mdi:pause",
                            "name": "Pause",
                            "show_name": true,
                            "show_icon": true,
                            "show_background": true,
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "script.nas_maintenance_pause",
                              "data": {
                                "nas": "calliope",
                                "what": "both",
                                "index_hours": "6"
                              }
                            }
                          },
                          {
                            "icon": "mdi:play",
                            "name": "Resume",
                            "show_name": true,
                            "show_icon": true,
                            "show_background": true,
