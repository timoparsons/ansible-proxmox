                  "cards": [
                    {
                      "type": "custom:mushroom-template-card",
                      "primary": "{% if has_value('sensor.node_proxmox_cpu_used') %}CPU {{ states('sensor.node_proxmox_cpu_used') | float(0) | round(0) | int }}% · RAM {{ states('sensor.node_proxmox_memory_used_percentage') | float(0) | round(0) | int }}% · Disk {{ states('sensor.node_proxmox_disk_used_percentage') | float(0) | round(0) | int }}%{% else %}Offline{% endif %}",
                      "secondary": "{% if has_value('sensor.node_proxmox_cpu_used') %}Swap {{ states('sensor.node_proxmox_swap_used_percentage') | float(0) | round(0) | int }}%{% if has_value('sensor.node_proxmox_last_boot') %} · up {{ relative_time(as_datetime(states('sensor.node_proxmox_last_boot'))) }}{% endif %}\n{% set l = states.binary_sensor | map(attribute='entity_id') | select('match', 'binary_sensor.lxc_.*_status') | list %}{{ l | select('is_state', 'on') | list | count }} of {{ l | count }} containers running{% endif %}",
                      "multiline_secondary": true,
                      "fill_container": true,
                      "grid_options": {
                        "columns": 12,
                        "rows": "auto"
                      },
                      "tap_action": {
                        "action": "more-info",
