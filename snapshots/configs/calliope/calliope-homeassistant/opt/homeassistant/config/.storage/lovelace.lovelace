        {
          "type": "sections",
          "max_columns": 1,
          "icon": "mdi:cog",
          "path": "maint",
          "title": "maint",
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:decluttering-card",
                  "template": "nav_bar_card_new"
                },
                {
                  "type": "custom:layout-card",
                  "layout_type": "custom:grid-layout",
                  "cards": [
                    {
                      "type": "custom:decluttering-card",
                      "template": "page_heading",
                      "variables": [
                        {
                          "name": "System"
                        }
                      ],
                      "view_layout": {
                        "grid-area": "title"
                      }
                    },
                    {
                      "view_layout": {
                        "grid-area": "one"
                      },
                      "type": "custom:mushroom-chips-card",
                      "alignment": "start",
                      "chips": [
                        {
                          "type": "template",
                          "entity": "sensor.ups_status_readable",
                          "tap_action": {
                            "action": "navigate",
                            "navigation_path": "#ups"
                          },
                          "content": "UPS {{ states('sensor.ups_status_readable') }}",
                          "content_info": "none",
                          "icon": "{{ state_attr('sensor.ups_status_readable', 'icon') or 'mdi:battery-outline' }}",
                          "icon_color": "{% if states('sensor.ups_status_readable') in ['ONLINE', 'CHARGING'] %}\n  green\n{% elif states('sensor.ups_status_readable') in ['ON BATTERY', 'DISCHARGING'] %}\n  orange\n{% elif states('sensor.ups_status_readable') == 'LOW BATTERY' %}\n  red\n{% else %}\n  gray\n{% endif %}",
                          "card_mod": {
                            "style": "ha-card {\n  --chip-icon-size: var(--icon-size) !important;\n  --chip-height: var(--chip-size) !important;\n  margin-top: var(--top_margin) !important;\n  border-radius: 2em !important;\n  justify-content: center;\n  padding-right: 3px;\n}\n"
                          }
                        },
                        {
                          "type": "template",
                          "entity": "binary_sensor.internet_connectivity",
                          "tap_action": {
                            "action": "navigate",
                            "navigation_path": "#internet"
                          },
                          "content": "{% if is_state(config.entity, 'on') %}\n  CONNECTED\n{% else %}\n  DISCONNECTED\n{% endif %}",
                          "content_info": "none",
                          "icon": "mdi:wan",
                          "icon_color": "{% if is_state(config.entity, 'on') %}\n  green\n{% else %}\n  red\n{% endif %}",
                          "card_mod": {
                            "style": "ha-card {\n  --chip-icon-size: var(--icon-size) !important;\n  --chip-height: var(--chip-size) !important;\n  margin-top: var(--top_margin) !important;\n  border-radius: 2em !important;\n  justify-content: center;\n  padding-right: 3px;\n}\n"
                          }
                        }
                      ],
                      "card_mod": {
                        "style": "ha-card {\n  --chip-size: 30px;\n  --icon-size: 20px;\n  --top_margin: 10px;\n}            \n"
                      }
                    }
                  ],
                  "layout": {
                    "grid-template-columns": "auto 1fr auto",
                    "grid-template-rows": "min-content",
                    "grid-template-areas": "\"title s one\"",
                    "margin": "0px 0px -4px 10px",
                    "padding": "20px 0px 0px 0px"
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "entity": "input_boolean.sidebar_toggle",
                  "icon": "mdi:menu",
                  "hold_action": {
                    "action": "more-info"
                  },
                  "double_tap_action": {
                    "action": "none"
                  },
                  "tap_action": {
                    "action": "toggle"
                  },
                  "primary": "",
                  "grid_options": {
                    "columns": 6,
                    "rows": 1
                  },
                  "color": "{% if is_state(entity,'on') %}\n  light-blue\n{% else %}\n  gray\n{% endif %}\n",
                  "features_position": "bottom",
                  "vertical": true
                },
                {
                  "type": "custom:mushroom-template-card",
                  "entity": "input_boolean.lovelace_show_detailed_data",
                  "icon": "mdi:monitor-screenshot",
                  "hold_action": {
                    "action": "more-info"
                  },
                  "double_tap_action": {
                    "action": "none"
                  },
                  "tap_action": {
                    "action": "toggle"
                  },
                  "primary": "",
                  "grid_options": {
                    "columns": 6,
                    "rows": 1
                  },
                  "color": "{% if is_state(entity,'on') %}\n  light-blue\n{% else %}\n  gray\n{% endif %}\n",
                  "features_position": "bottom",
                  "vertical": true
                },
                {
                  "type": "custom:mushroom-template-card",
                  "entity": "sensor.mac_mini_cpu_temperature",
                  "primary": "Mac Server",
                  "icon": "mdi:server-network",
                  "icon_color": "{% set temp = states('sensor.mac_mini_cpu_temperature') | float(0) %}\n{% if temp < 70 %}\n  green\n{% elif temp < 80 %}\n  orange\n{% else %}\n  red\n{% endif %}\n",
                  "tap_action": {
                    "action": "navigate",
                    "navigation_path": "#mac-server"
                  },
                  "secondary": "CPU: {{ states('sensor.mac_mini_cpu_usage') }}% · Temp: {{ states('sensor.mac_mini_cpu_temperature') }}°C\nFan: {{ states('sensor.mac_mini_fan_speed') }} RPM",
                  "layout": "vertical",
                  "fill_container": false,
                  "multiline_secondary": true
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Synology",
                  "icon": "mdi:nas",
                  "icon_color": "{% set ns = namespace(lvl=-1) %}{% for x, v in [('calliope', 'calliope_volume_2'), ('norwich', 'norwich_volume_1')] %}{% if has_value('sensor.' ~ x ~ '_temperature') %}{% set t = states('sensor.' ~ x ~ '_temperature') | float(0) %}{% set u = states('sensor.' ~ v ~ '_volume_used') | float(0) %}{% set l = 2 if (t >= 70 or u >= 90 or states('sensor.' ~ v ~ '_status') != 'normal' or is_state('binary_sensor.' ~ x ~ '_security_status', 'on')) else (1 if (t >= 55 or u >= 80) else 0) %}{% if l > ns.lvl %}{% set ns.lvl = l %}{% endif %}{% endif %}{% endfor %}{% if ns.lvl == 2 %}red{% elif ns.lvl == 1 %}orange{% elif ns.lvl == 0 %}green{% else %}grey{% endif %}",
                  "tap_action": {
                    "action": "navigate",
                    "navigation_path": "#synology"
                  },
                  "secondary": "{% for x, v in [('calliope', 'calliope_volume_2'), ('norwich', 'norwich_volume_1')] %}{{ x | capitalize }} {% if has_value('sensor.' ~ x ~ '_temperature') %}{{ states('sensor.' ~ x ~ '_temperature') | int(0) }}°C · {{ states('sensor.' ~ v ~ '_volume_used') | float(0) | round(0) | int }}% full{% else %}offline{% endif %}{% if not loop.last %}\n{% endif %}{% endfor %}",
                  "layout": "vertical",
                  "fill_container": false,
                  "multiline_secondary": true
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Proxmox",
                  "icon": "mdi:cube-outline",
                  "icon_color": "{% if is_state('binary_sensor.node_proxmox_status', 'on') %}{% if states('sensor.node_proxmox_cpu_used') | float(0) >= 90 or states('sensor.node_proxmox_memory_used_percentage') | float(0) >= 85 or states('sensor.node_proxmox_disk_used_percentage') | float(0) >= 80 %}orange{% else %}green{% endif %}{% elif is_state('binary_sensor.node_proxmox_status', 'off') %}red{% else %}grey{% endif %}",
                  "tap_action": {
                    "action": "navigate",
                    "navigation_path": "#proxmox"
                  },
                  "layout": "vertical",
                  "fill_container": false,
                  "multiline_secondary": true,
