                          }
                        }
                      ],
                      "grid_options": {
                        "columns": 12,
                        "rows": "auto"
                      }
                    },
                    {
                      "type": "iframe",
                      "url": "https://embed.windy.com/embed.html?type=map&location=coordinates&metricRain=default&metricTemp=default&metricWind=default&zoom=9&overlay=rain&product=ecmwf&level=surface&lat=-36.907&lon=174.737&message=true",
                      "aspect_ratio": "50%",
                      "grid_options": {
                        "columns": 12,
                        "rows": "auto"
                      }
                    },
                    {
                      "type": "custom:horizon-card",
                      "card_mod": {
                        "style": ".horizon-card {\n    font-size: 0.91rem !important;\n    color: var(--primary-text-color) !important;\n}\nha-card > div > div.horizon-card-header > div:nth-child(1) >\nspan.horizon-card-field-name {\n  font-size: 1rem !important;\n}\nha-card > div > div.horizon-card-header > div:nth-child(2) >\nspan.horizon-card-field-name {\n  font-size: 1rem !important;\n}\n"
                      },
                      "grid_options": {
                        "columns": 12,
                        "rows": "auto"
                      }
                    },
                    {
                      "type": "custom:stack-in-card",
                      "cards": [
                        {
                          "type": "custom:card-templater",
                          "entities": [
                            "sensor.local_tides"
                          ],
                          "card": {
                            "type": "entities",
                            "entities": [
                              {
                                "type": "custom:template-entity-row",
                                "entity": "sensor.local_tides",
                                "state_template": "{% if state_attr('sensor.local_tides', 'next_low_tide_time') is defined and state_attr('sensor.local_tides', 'next_high_tide_time') is defined %}\n  {% if state_attr('sensor.local_tides', 'next_low_tide_time') and state_attr('sensor.local_tides', 'next_high_tide_time') %}\n    {% if state_attr('sensor.local_tides', 'next_low_tide_time') < state_attr('sensor.local_tides', 'next_high_tide_time') %}\n      {{ state_attr('sensor.local_tides', 'next_low_tide_time') | string | regex_replace('(\\\\d{4}-\\\\d{2}-\\\\d{2}) (\\\\d{2}:\\\\d{2}):\\\\d{2}', '\\\\2') }}\n    {% else %}\n      {{ state_attr('sensor.local_tides', 'next_high_tide_time') | string | regex_replace('(\\\\d{4}-\\\\d{2}-\\\\d{2}) (\\\\d{2}:\\\\d{2}):\\\\d{2}', '\\\\2') }}\n    {% endif %}\n  {% else %}\n    N/A\n  {% endif %}\n{% else %}\n  N/A\n{% endif %}\n",
                                "name_template": "{% if state_attr('sensor.local_tides', 'next_low_tide_time') is defined and state_attr('sensor.local_tides', 'next_high_tide_time') is defined %}\n  {% if state_attr('sensor.local_tides', 'next_low_tide_time') and state_attr('sensor.local_tides', 'next_high_tide_time') %}\n    {% if state_attr('sensor.local_tides', 'next_low_tide_time') < state_attr('sensor.local_tides', 'next_high_tide_time') %}\n      Next low tide\n    {% else %}\n      Next high tide\n    {% endif %}\n  {% else %}\n    N/A\n  {% endif %}\n{% else %}\n  N/A\n{% endif %}\n",
                                "icon_template": "{% if state_attr('sensor.local_tides', 'next_low_tide_time') is defined and state_attr('sensor.local_tides', 'next_high_tide_time') is defined %}\n  {% if state_attr('sensor.local_tides', 'next_low_tide_time') and state_attr('sensor.local_tides', 'next_high_tide_time') %}\n    {% if state_attr('sensor.local_tides', 'next_low_tide_time') < state_attr('sensor.local_tides', 'next_high_tide_time') %}\n      mdi:wave\n    {% else %}\n      mdi:waves\n    {% endif %}\n  {% else %}\n    mdi:help\n  {% endif %}\n{% else %}\n  mdi:help\n{% endif %}\n",
                                "show_empty": false,
                                "hold_action": {
                                  "action": "none"
                                },
                                "card_mod": {
                                  "style": ".state {\nfont-size: 20px; /* Adjust the font size as desired */\n}\n"
                                }
                              },
                              {
                                "type": "custom:template-entity-row",
                                "entity": "sensor.local_tides",
                                "state_template": "{% if state_attr('sensor.local_tides', 'next_low_tide_time') is defined and state_attr('sensor.local_tides', 'next_high_tide_time') is defined %}\n  {% if state_attr('sensor.local_tides', 'next_low_tide_time') and state_attr('sensor.local_tides', 'next_high_tide_time') %}\n    {% if state_attr('sensor.local_tides', 'next_low_tide_time') > state_attr('sensor.local_tides', 'next_high_tide_time') %}\n      {{ state_attr('sensor.local_tides', 'next_low_tide_time') | string | regex_replace('(\\\\d{4}-\\\\d{2}-\\\\d{2}) (\\\\d{2}:\\\\d{2}):\\\\d{2}', '\\\\2') }}\n    {% else %}\n      {{ state_attr('sensor.local_tides', 'next_high_tide_time') | string | regex_replace('(\\\\d{4}-\\\\d{2}-\\\\d{2}) (\\\\d{2}:\\\\d{2}):\\\\d{2}', '\\\\2') }}\n    {% endif %}\n  {% else %}\n    N/A\n  {% endif %}\n{% else %}\n  N/A\n{% endif %}\n",
                                "name_template": "{% if state_attr('sensor.local_tides', 'next_low_tide_time') is defined and state_attr('sensor.local_tides', 'next_high_tide_time') is defined %}\n  {% if state_attr('sensor.local_tides', 'next_low_tide_time') and state_attr('sensor.local_tides', 'next_high_tide_time') %}\n    {% if state_attr('sensor.local_tides', 'next_low_tide_time') > state_attr('sensor.local_tides', 'next_high_tide_time') %}\n      Next low tide\n    {% else %}\n      Next high tide\n    {% endif %}\n  {% else %}\n    N/A\n  {% endif %}\n{% else %}\n  N/A\n{% endif %}\n",
                                "icon_template": "{% if state_attr('sensor.local_tides', 'next_low_tide_time') is defined and state_attr('sensor.local_tides', 'next_high_tide_time') is defined %}\n  {% if state_attr('sensor.local_tides', 'next_low_tide_time') and state_attr('sensor.local_tides', 'next_high_tide_time') %}\n    {% if state_attr('sensor.local_tides', 'next_low_tide_time') > state_attr('sensor.local_tides', 'next_high_tide_time') %}\n      mdi:wave\n    {% else %}\n      mdi:waves\n    {% endif %}\n  {% else %}\n    mdi:help\n  {% endif %}\n{% else %}\n  mdi:help\n{% endif %}\n",
                                "show_empty": false,
                                "hold_action": {
                                  "action": "none"
                                },
                                "style": ".state {\n  font-size: 20px; /* Adjust the font size as desired */\n}\n"
                              }
                            ]
                          }
                        }
                      ],
                      "grid_options": {
                        "columns": 12,
                        "rows": "auto"
                      }
