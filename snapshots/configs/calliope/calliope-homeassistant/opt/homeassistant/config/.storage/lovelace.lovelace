                  "hash": "#synology",
                  "name": "Synology",
                  "icon": "",
                  "button_type": "name",
                  "bg_blur": "25",
                  "bg_opacity": "0",
                  "close_on_click": false,
                  "margin_top_mobile": "-56px",
                  "scrolling_effect": false,
                  "width_desktop": "540px",
                  "sub_button": {
                    "bottom": [],
