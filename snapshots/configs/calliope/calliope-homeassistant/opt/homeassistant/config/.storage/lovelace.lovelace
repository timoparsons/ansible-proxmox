                      "keep": {
                        "border": false
                      },
                      "cards": [
                        {
                          "type": "custom:mod-card",
                          "card": {
                            "type": "entities",
                            "styles": null,
                            "card_mod": {
                              "style": "ha-card {\n  font-size: 16px;\n  --ha-card-header-font-size: 20px; \n  --card-top-margin: -10px;\n  border: none;\n\n}\n"
                            },
                            "entities": [
                              {
                                "entity": "sensor.next_tide1",
                                "type": "custom:multiple-entity-row",
                                "card_mod": {
                                  "style": {
                                    "hui-generic-entity-row $": "ha-card {\n  background-color: transparent; !important;\n}\nstate-badge {\n  margin-top: -12px;\n  margin-left: -10px !important;\n}\n.info {\n  margin-top: -12px;\n  margin-left: 5px !important;\n  margin-bottom: -4px;\n}\n",
                                    ".": "\n.entities-row .entity {\n  margin-top: var(--card-top-margin);\n}\n"
                                  }
                                },
                                "format": "time",
                                "styles": {
                                  "padding": "0px 0px 0px 0px;",
                                  "font-size": "20px;",
                                  "color": "var(--font-color-next1)"
                                },
                                "entities": [
                                  {
                                    "type": "custom:template-entity-row",
                                    "entity": "sensor.next_tide1",
                                    "format": "relative",
                                    "name": false,
                                    "styles": {
                                      "font-size": "13px;",
                                      "text-transform": "lowercase",
                                      "margin-bottom": "-5px",
                                      "margin-right": "10px",
                                      "color": "var(--font-color-next1)"
                                    }
                                  }
                                ]
                              },
                              {
                                "entity": "sensor.next_tide2",
                                "type": "custom:multiple-entity-row",
                                "icon": "none",
                                "name": false,
                                "card_mod": {
                                  "style": {
                                    "hui-generic-entity-row $": "state-badge {\n  margin-top: -25px;\n  margin-left: -10px !important;\n}\n.info {\n  margin-top: var(--card-top-margin);\n  margin-bottom: -5px;\n  font-size: 13px;\n\n  text-align: right;\n  text-transform: lowercase\n}\n",
                                    ".": "\n.entities-row .entity {\n  #margin-top: var(--card-top-margin);\n}\n"
                                  }
                                },
                                "format": "time",
                                "styles": {
                                  "padding": "0px 0px 0px 0px;",
                                  "font-size": "20px;",
                                  "color": "var(--font-color-next1)"
                                }
                              }
                            ]
                          },
                          "card_mod": {
                            "style": "ha-card {\n  border: none !important;\n  padding: 0px 0px 0px 0px;\n  #margin-top: -5px !important;\n  margin-bottom: -20px !important;\n}  \n"
                          }
                        },
                        {
                          "type": "custom:mini-graph-card",
                          "entities": [
                            "sensor.local_tides"
                          ],
                          "align_state": "center",
                          "hours_to_show": 24,
                          "points_per_hour": 60,
                          "height": 80,
                          "show": {
                            "icon": false,
                            "name": false,
                            "state": false,
                            "extrema": false,
                            "legend": false
                          },
                          "card_mod": {
