                        {
                          "type": "custom:mushroom-template-card",
                          "entity": "sensor.halcyon_ups_ups_shutdown_delay",
                          "primary": "Shutdown Delay",
                          "secondary": "{% set delay = states('sensor.halcyon_ups_ups_shutdown_delay') | float(0) %} {% if delay >= 60 %}\n  {% set mins = delay / 60 %}\n  {% if mins == (mins | round(0)) %}\n    {{ mins | round(0) | int }} min\n  {% else %}\n    {{ mins | round(1) }} min\n  {% endif %}\n{% else %}\n  {{ delay | round(0) | int }} sec\n{% endif %}",
                          "icon": "mdi:clock-time-eight-outline",
                          "icon_color": "blue",
                          "tap_action": {
                            "action": "more-info",
                            "entity": "input_number.ups_shutdown_delay"
                          }
                        },
                        {
