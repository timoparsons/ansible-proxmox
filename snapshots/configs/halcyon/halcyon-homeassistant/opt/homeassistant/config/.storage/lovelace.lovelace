{
  "version": 1,
  "minor_version": 1,
  "key": "REDACTED",
  "data": {
    "config": {
      "decluttering_templates": {
        "basic_entity_card": {
          "card": {
            "type": "entity",
            "entity": "[[entity]]",
            "name": "[[name]]"
          }
        },
        "graph_controls": {
          "card": {
            "type": "horizontal-stack",
            "cards": [
              {
                "type": "custom:mushroom-number-card",
                "entity": "input_number.minigraph_hours_to_show",
                "name": "Hours",
                "icon": "mdi:clock-outline",
                "card_mod": {
                  "style": "ha-card {\n  --control-height: 12px;\n}\n"
                }
              },
              {
                "type": "custom:mushroom-number-card",
                "entity": "input_number.minigraph_points_per_hour",
                "name": "Points/Hr",
                "icon": "mdi:chart-line",
                "card_mod": {
                  "style": "ha-card {\n  --control-height: 12px;\n}\n"
                }
              }
            ]
          }
        },
        "lxc_service_button": {
          "card": {
            "type": "custom:bubble-card",
            "card_type": "button",
            "entity": "[[entity]]",
            "show_state": true,
            "show_last_changed": false,
            "show_attribute": false,
            "force_icon": false,
            "name": "[[name]]",
            "sub_button": [
              {
                "entity": "[[lxc_cpu]]",
                "icon": "mdi:cpu-64-bit",
                "name": "CPU",
                "unit": "%",
                "show_state": true,
                "show_name": true,
                "show_icon": false
              },
              {
                "entity": "script.lxc_restart",
                "name": "Reboot",
                "icon": "mdi:restart",
                "tap_action": {
                  "action": "call-service",
                  "service": "script.backend_restart_lxc_container",
                  "data": {
                    "lxc_name": "[[lxc_name]]"
                  }
                }
              },
              {
                "entity": "script.lxc_toggle",
                "name": "Power",
                "icon": "mdi:power",
                "tap_action": {
                  "action": "call-service",
                  "service": "script.backend_toggle_lxc_container",
                  "data": {
                    "lxc_name": "[[lxc_name]]"
                  }
                }
              }
            ],
            "card_layout": "large",
            "grid_options": {
              "columns": "full",
              "rows": 1
            },
            "show_icon": true,
            "scrolling_effect": false,
            "icon": "[[icon]]",
            "button_action": {
              "tap_action": {
                "action": "more-info"
              }
            },
            "button_type": "switch",
            "styles": ".bubble-button-background {\n  background: var(--card-background-color) !important;\n}\n.bubble-sub-button {\n  background-color: var(--card-background-color) !important;\n}\n"
          },
          "default": [
            {
              "name": "Jellyfin"
            },
            {
              "lxc_name": "jellyfin_143"
            },
            {
              "icon": "mdi:jellyfish-outline"
            },
            {
              "entity": "binary_sensor.lxc_jellyfin_143_status"
            },
            {
              "lxc_cpu": "sensor.lxc_jellyfin_143_cpu_used"
            },
            {
              "lxc_reboot": "button.lxc_jellyfin_143_reboot"
            }
          ],
          "grid_options": {
            "columns": 12,
            "rows": "auto"
          }
        },
        "templated_mini_graph_binarysensor": {
          "card": {
            "type": "custom:config-template-card",
            "variables": {
              "HOURS": "states['[[hours_entity]]'].state",
              "POINTS": "states['[[points_entity]]'].state"
            },
            "entities": [
              "[[hours_entity]]",
              "[[points_entity]]"
            ],
            "card": {
              "type": "custom:mini-graph-card",
              "name": "[[card_name]]",
              "icon": "[[icon]]",
              "entities": "[[graph_entities]]",
              "state_map": [
                {
                  "value": "off",
                  "label": "[[off_label]]"
                },
                {
                  "value": "on",
                  "label": "[[on_label]]"
                }
              ],
              "hours_to_show": "${HOURS}",
              "points_per_hour": "${POINTS}",
              "line_width": 2,
              "font_size": 75,
              "animate": true,
              "smoothing": false,
              "show": {
                "name": true,
                "icon": true,
                "state": true,
                "legend": false
              },
              "color_thresholds": [
                {
                  "value": 0,
                  "color": "[[off_color]]"
                },
                {
                  "value": 1,
                  "color": "[[on_color]]"
                }
              ]
            }
          },
          "default": [
            {
              "hours_entity": "input_number.minigraph_hours_to_show"
            },
            {
              "points_entity": "input_number.minigraph_points_per_hour"
            },
            {
              "card_name": "Binary Sensor"
            },
            {
              "icon": "mdi:toggle-switch"
            },
            {
              "graph_entities": [
                {
                  "entity": "binary_sensor.door_bathroom_contact",
                  "name": "Bathroom Door"
                }
              ]
            },
            {
              "off_label": "Closed"
            },
            {
              "off_color": "#0366d6"
            },
            {
              "on_label": "Open"
            },
            {
              "on_color": "#0366d6"
            }
          ]
        },
        "templated_mini_graph_generic": {
          "card": {
            "type": "custom:config-template-card",
            "variables": {
              "HOURS": "states['[[hours_entity]]'].state",
              "POINTS": "states['[[points_entity]]'].state"
            },
            "entities": [
              "[[hours_entity]]",
              "[[points_entity]]"
            ],
            "card": {
              "type": "custom:mini-graph-card",
              "name": "[[card_name]]",
              "icon": "[[icon]]",
              "entities": "[[graph_entities]]",
              "hours_to_show": "${HOURS}",
              "points_per_hour": "${POINTS}",
              "line_width": 2,
              "font_size": 75,
              "animate": true,
              "show": {
                "name": true,
                "icon": true,
                "state": true,
                "legend": false
              },
              "color_thresholds": [
                {
                  "value": "[[value_low]]",
                  "color": "[[color_low]]"
                },
                {
                  "value": "[[value_high]]",
                  "color": "[[color_high]]"
                }
              ]
            }
          },
          "default": [
            {
              "hours_entity": "input_number.minigraph_hours_to_show"
            },
            {
              "points_entity": "input_number.minigraph_points_per_hour"
            },
            {
              "card_name": "Generic"
            },
            {
              "icon": "mdi:home"
            },
            {
              "value_low": 0
            },
            {
              "color_low": "#3498db"
            },
            {
              "value_high": 100
            },
            {
              "color_high": "#3498db"
            },
            {
              "graph_entities": [
                {
                  "entity": "sensor.temperature_lounge_humidity",
                  "name": "Lounge"
                }
              ]
            }
          ]
        }
      },
      "views": [
        {
          "icon": "mdi:home",
          "type": "custom:vertical-layout",
          "badges": [],
          "cards": [
            {
              "type": "custom:frigate-card",
              "cameras": [
                {
                  "camera_entity": "camera.driveway",
                  "live_provider": "go2rtc",
                  "go2rtc": {
                    "stream": "driveway"
                  },
                  "webrtc_card": {}
                }
              ],
              "dimensions": {
                "aspect_ratio": "16:9"
              },
              "menu": {
                "style": "outside",
                "position": "bottom"
              },
              "live": {
                "zoomable": true
              }
            },
            {
              "type": "custom:stack-in-card",
              "cards": [
                {
                  "type": "custom:button-card",
                  "name": "Disable Camera Detection",
                  "show_name": true,
                  "show_icon": true,
                  "color": "var(--button-card-light-color)",
                  "hold_action": {
                    "action": "more-info"
                  },
                  "tap_action": {
                    "action": "toggle"
                  },
                  "entity": "input_boolean.driveway_silence_detection",
                  "size": "40px",
                  "styles": {
                    "card": [
                      {
                        "height": "120px"
                      },
                      {
                        "font-size": "12px"
                      },
                      {
                        "padding": "7%"
                      }
                    ]
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "entity": "timer.security_notifications_mute",
                      "state": "active"
                    }
                  ],
                  "card": {
                    "type": "custom:timer-bar-card",
                    "entities": [
                      "timer.security_notifications_mute"
                    ],
                    "bar_direction": "ltr",
                    "invert": true,
                    "state_color": true,
                    "icon": "mdi:lightbulb-outline",
                    "active_icon": "mdi:lightbulb",
                    "bar_foreground": "orange",
                    "bar_background": "black",
                    "layout": "full_row",
                    "text_width": "60px",
                    "bar_height": "5px"
                  }
                }
              ]
            },
            {
              "type": "custom:stack-in-card",
              "cards": [
                {
                  "type": "tile",
                  "entity": "light.security_lights",
                  "name": "Security Lights",
                  "icon": "mdi:lightbulb",
                  "icon_tap_action": {
                    "action": "call-service",
                    "service": "script.driveway_security_lights_toggle",
                    "target": {
                      "entity_id": "script.driveway_security_lights_toggle"
                    }
                  }
                },
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "entity": "timer.driveway_lights_timer",
                      "state": "active"
                    }
                  ],
                  "card": {
                    "type": "custom:timer-bar-card",
                    "entities": [
                      "timer.driveway_lights_timer"
                    ],
                    "bar_direction": "ltr",
                    "invert": true,
                    "state_color": true,
                    "icon": "mdi:lightbulb-outline",
                    "active_icon": "mdi:lightbulb",
                    "bar_foreground": "orange",
                    "bar_background": "black",
                    "layout": "full_row",
                    "text_width": "0px",
                    "bar_height": "5px"
                  }
                }
              ]
            }
          ]
        },
        {
          "path": "recordings",
          "icon": "mdi:movie-open-play-outline",
          "type": "custom:vertical-layout",
          "badges": [],
          "cards": [
            {
              "type": "custom:frigate-card",
              "cameras": [
                {
                  "camera_entity": "camera.driveway"
                }
              ],
              "view": {
                "default": "snapshot"
              },
              "live": {
                "draggable": false,
                "zoomable": false,
                "lazy_load": false
              },
              "media_viewer": {
                "draggable": false,
                "zoomable": false,
                "controls": {
                  "builtin": false,
                  "next_previous": {
                    "style": "none"
                  }
                },
                "snapshot_click_plays_clip": false
              },
              "image": {
                "url": "/local/driveway_snapshot.jpg",
                "refresh_seconds": 10
              },
              "menu": {
                "style": "overlay",
                "buttons": {
                  "frigate": {
                    "enabled": false
                  },
                  "cameras": {
                    "enabled": false
                  },
                  "substreams": {
                    "enabled": false
                  },
                  "live": {
                    "enabled": false
                  },
                  "clips": {
                    "enabled": false
                  },
                  "snapshots": {
                    "enabled": false
                  },
                  "download": {
                    "enabled": false
                  },
                  "camera_ui": {
                    "enabled": false
                  },
                  "timeline": {
                    "enabled": false
                  },
                  "media_player": {
                    "enabled": false
                  }
                },
                "position": "bottom",
                "alignment": "left"
              },
              "media_gallery": {
                "controls": {
                  "filter": {
                    "mode": "none"
                  },
                  "thumbnails": {
                    "show_timeline_control": false
                  }
                }
              }
            },
            {
              "type": "custom:frigate-card",
              "cameras": [
                {
                  "camera_entity": "camera.driveway"
                }
              ],
              "view": {
                "default": "snapshots"
              },
              "menu": {
                "style": "outside"
              },
              "media_gallery": {
                "controls": {
                  "thumbnails": {
                    "show_timeline_control": false,
                    "size": 154,
                    "show_details": false,
                    "show_favorite_control": true
                  },
                  "filter": {
                    "mode": "none"
                  }
                }
              },
              "dimensions": {
                "aspect_ratio_mode": "unconstrained",
                "max_height": "60vh"
              },
              "live": {
                "draggable": false,
                "zoomable": false,
                "lazy_load": false
              },
              "media_viewer": {
                "controls": {
                  "builtin": true,
                  "thumbnails": {
                    "mode": "none"
                  },
                  "next_previous": {
                    "style": "chevrons"
                  },
                  "timeline": {
                    "mode": "none"
                  },
                  "title": {
                    "mode": "none"
                  }
                },
                "draggable": false,
                "snapshot_click_plays_clip": false
              }
            }
          ]
        },
        {
          "path": "camera",
          "icon": "mdi:cctv",
          "type": "custom:vertical-layout",
          "badges": [],
          "cards": [
            {
              "type": "entities",
              "entities": [
                {
                  "entity": "input_number.driveway_lights_timer_duration_camera",
                  "name": "Camera Detection",
                  "secondary_info": "none"
                },
                {
                  "entity": "input_number.driveway_lights_timer_duration_beamcross",
                  "name": "Beam Cross Detection"
                }
              ],
              "title": "Security Light Timer Duration"
            },
            {
              "type": "entities",
              "entities": [
                {
                  "entity": "input_number.security_notifications_mute_duration",
                  "name": "Mute for"
                }
              ],
              "title": "Mute Notifications Timer"
            },
            {
              "type": "entities",
              "entities": [
                {
                  "entity": "input_number.security_notifications_debounce_duration",
                  "name": "Silence for",
                  "icon": "mdi:timer-edit-outline"
                }
              ],
              "title": "Notification Cooldown Period"
            },
            {
              "type": "entities",
              "entities": [
                {
                  "entity": "binary_sensor.halcyon_driveway_motion",
                  "name": "Motion"
                },
                {
                  "entity": "binary_sensor.halcyon_driveway_vehicle",
                  "name": "Vehicle"
                },
                {
                  "entity": "binary_sensor.halcyon_driveway_person",
                  "name": "Person"
                },
                {
                  "entity": "binary_sensor.halcyon_driveway_animal",
                  "name": "Animal"
                }
              ],
              "title": "Camera Sensors",
              "state_color": true
            },
            {
              "type": "entities",
              "entities": [
                {
                  "entity": "binary_sensor.driveway_all_occupancy"
                },
                {
                  "entity": "binary_sensor.driveway_motion"
                },
                {
                  "entity": "binary_sensor.driveway_car_occupancy"
                },
                {
                  "entity": "binary_sensor.driveway_person_occupancy"
                }
              ],
              "title": "Frigate Sensors",
              "state_color": true
            },
            {
              "type": "entities",
              "entities": [
                {
                  "entity": "switch.driveway_detect",
                  "name": "Detect Cars & People"
                },
                {
                  "entity": "switch.driveway_motion",
                  "name": "Detect Motion"
                },
                {
                  "entity": "switch.driveway_recordings",
                  "name": "Record Events"
                }
              ],
              "title": "Frigate Controls",
              "show_header_toggle": false,
              "state_color": false
            },
            {
              "type": "entities",
              "entities": [
                {
                  "entity": "number.halcyon_driveway_motion_sensitivity",
                  "name": "Motion Sensitivity"
                },
                {
                  "entity": "number.halcyon_driveway_ai_vehicle_sensitivity",
                  "name": "Vehilce Sensitivity"
                },
                {
                  "entity": "number.halcyon_driveway_ai_person_sensitivity",
                  "name": "Person Sensitivity"
                },
                {
                  "entity": "number.halcyon_driveway_ai_animal_sensitivity",
                  "name": "Animal Sensitivity"
                }
              ],
              "title": "Camera Detection"
            },
            {
              "type": "entities",
              "entities": [
                {
                  "entity": "number.halcyon_driveway_zoom",
                  "name": "Zoom"
                },
                {
                  "entity": "select.halcyon_driveway_day_night_mode",
                  "name": "Night Mode"
                },
                {
                  "entity": "select.halcyon_driveway_floodlight_mode",
                  "name": "Floodlight Mode"
                },
                {
                  "entity": "light.halcyon_driveway_floodlight",
                  "name": "Floodlight"
                },
                {
                  "entity": "number.halcyon_driveway_floodlight_turn_on_brightness",
                  "name": "Floodlight Brightness"
                },
                {
                  "entity": "switch.halcyon_driveway_infra_red_lights_in_night_mode",
                  "name": "Infra-red Lights"
                },
                {
                  "entity": "switch.halcyon_driveway_record",
                  "name": "Record on-camera"
                },
                {
                  "entity": "switch.halcyon_driveway_record_audio",
                  "name": "Record audio"
                }
              ],
              "title": "Camera Controls"
            }
          ]
        },
        {
          "path": "people",
          "icon": "mdi:account",
          "badges": [],
          "cards": [
            {
              "type": "entities",
              "entities": [
                {
                  "entity": "person.dick"
                },
                {
                  "entity": "sensor.dick_notification_level"
                },
                {
                  "entity": "sensor.dicks_iphone_geocoded_location",
                  "name": "Location"
                },
                {
                  "entity": "sensor.halcyon_dick_distance",
                  "name": "Distance from Home"
                },
                {
                  "entity": "sensor.dicks_iphone_ssid",
                  "name": "WiFi Connection"
                },
                {
                  "entity": "sensor.dicks_iphone_last_update_trigger",
                  "name": "Last Update"
                },
                {
                  "entity": "binary_sensor.dicks_iphone_focus",
                  "name": "Focus Mode"
                }
              ],
              "state_color": true
            },
            {
              "type": "entities",
              "entities": [
                {
                  "entity": "person.helen"
                },
                {
                  "entity": "sensor.helen_notification_level"
                },
                {
                  "entity": "sensor.helens_iphone_geocoded_location",
                  "name": "Location"
                },
                {
                  "entity": "sensor.halcyon_helen_distance",
                  "name": "Distance from Home"
                },
                {
                  "entity": "sensor.helens_iphone_ssid",
                  "name": "WiFi Connection"
                },
                {
                  "entity": "sensor.helens_iphone_last_update_trigger",
                  "name": "Last Update"
                },
                {
                  "entity": "binary_sensor.helens_iphone_focus",
                  "name": "Focus Mode"
                }
              ],
              "state_color": true
            },
            {
              "type": "entities",
              "entities": [
                {
                  "entity": "sensor.halcyon_nearest_device"
                },
                {
                  "entity": "sensor.halcyon_dick_distance"
                },
                {
                  "entity": "sensor.halcyon_dick_direction_of_travel"
                },
                {
                  "entity": "sensor.halcyon_helen_distance"
                },
                {
                  "entity": "sensor.halcyon_helen_direction_of_travel"
                }
              ],
              "title": "Proximity"
            },
            {
              "type": "map",
              "entities": [
                {
                  "entity": "zone.home"
                },
                {
                  "entity": "person.dick"
                },
                {
                  "entity": "person.helen"
                }
              ],
              "title": "Location",
              "dark_mode": false,
              "auto_fit": true,
              "default_zoom": 17,
              "hours_to_show": 0
            }
          ]
        },
        {
          "icon": "mdi:cog",
          "type": "sections",
          "badges": [],
          "cards": [],
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:layout-card",
                  "layout_type": "custom:grid-layout",
                  "cards": [
                    {
                      "type": "custom:button-card",
                      "name": "System",
                      "styles": {
                        "card": [
                          {
                            "background": "transparent"
                          },
                          {
                            "height": "40px"
                          },
                          {
                            "border-radius": "0px"
                          },
                          {
                            "margin-right": "10px"
                          }
                        ],
                        "name": [
                          {
                            "justify-self": "start"
                          },
                          {
                            "font-size": "26px"
                          },
                          {
                            "font-weight": "bold"
                          }
                        ]
                      },
                      "show_state": false,
                      "show_name": true,
                      "show_icon": false,
                      "layout_options": {
                        "grid_columns": 4,
                        "grid_rows": 1.2
                      }
                    },
                    {
                      "view_layout": {
                        "grid-area": "one"
                      },
                      "type": "custom:mushroom-chips-card",
                      "alignment": "start",
                      "chips": [
                        {
                          "type": "template",
                          "entity": "sensor.ups_status_readable",
                          "tap_action": {
                            "action": "navigate",
                            "navigation_path": "#ups"
                          },
                          "content": "UPS {{ states('sensor.ups_status_readable') }}",
                          "content_info": "none",
                          "icon": "{{ state_attr('sensor.ups_status_readable', 'icon') or 'mdi:battery-outline' }}",
                          "icon_color": "{% if states('sensor.ups_status_readable') in ['ONLINE', 'CHARGING'] %}\n  green\n{% elif states('sensor.ups_status_readable') == 'ON BATTERY' %}\n  orange\n{% elif states('sensor.ups_status_readable') == 'LOW BATTERY' %}\n  red\n{% else %}\n  gray\n{% endif %}",
                          "card_mod": {
                            "style": "ha-card {\n  --chip-icon-size: var(--icon-size) !important;\n  --chip-height: var(--chip-size) !important;\n  margin-top: var(--top_margin) !important;\n  border-radius: 2em !important;\n  justify-content: center;\n  padding-right: 3px;\n}\n"
                          }
                        },
                        {
                          "type": "template",
                          "entity": "binary_sensor.internet_connectivity",
                          "tap_action": {
                            "action": "navigate",
                            "navigation_path": "#internet"
                          },
                          "content": "{% if is_state(config.entity, 'on') %}\n  CONNECTED\n{% else %}\n  DISCONNECTED\n{% endif %}",
                          "content_info": "none",
                          "icon": "mdi:wan",
                          "icon_color": "{% if is_state(config.entity, 'on') %}\n  green\n{% else %}\n  red\n{% endif %}",
                          "card_mod": {
                            "style": "ha-card {\n  --chip-icon-size: var(--icon-size) !important;\n  --chip-height: var(--chip-size) !important;\n  margin-top: var(--top_margin) !important;\n  border-radius: 2em !important;\n  justify-content: center;\n  padding-right: 3px;\n}\n"
                          }
                        }
