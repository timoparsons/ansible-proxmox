                {
                  "type": "custom:mushroom-template-card",
                  "entity": "sensor.mac_mini_cpu_temperature",
                  "primary": "N100 Server",
                  "icon": "mdi:server-network",
                  "icon_color": "{% set temp = states('sensor.mac_mini_cpu_temperature') | float(0) %}\n{% if temp < 70 %}\n  green\n{% elif temp < 80 %}\n  orange\n{% else %}\n  red\n{% endif %}\n",
                  "tap_action": {
                    "action": "navigate",
                    "navigation_path": "#mac-server"
                  },
                  "secondary": "CPU: {{ states('sensor.mac_mini_cpu_usage') }}% · Temp: {{ states('sensor.mac_mini_cpu_temperature') }}°C\nFan: {{ states('sensor.mac_mini_fan_speed') }} RPM",
                  "layout": "vertical",
                  "fill_container": false,
                  "multiline_secondary": true
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Proxmox",
                  "icon": "mdi:robot",
                  "icon_color": "{% if states('binary_sensor.node_proxmox_status') in ['on'] %}\n  green\n{% else %}\n  red\n{% endif %}\n",
                  "tap_action": {
                    "action": "navigate",
                    "navigation_path": "#proxmox"
                  },
                  "layout": "vertical",
                  "fill_container": false,
                  "multiline_secondary": true,
                  "entity": "binary_sensor.node_proxmox_status",
                  "secondary": ""
                },
                {
                  "type": "custom:mushroom-template-card",
                  "icon": "mdi:nas",
                  "icon_color": "{% if has_value('sensor.halcyon_temperature') %}{% set t = states('sensor.halcyon_temperature') | float(0) %}{% set u = states('sensor.halcyon_volume_1_volume_used') | float(0) %}{% if t >= 70 or u >= 90 or states('sensor.halcyon_volume_1_status') != 'normal' or is_state('binary_sensor.halcyon_security_status', 'on') %}red{% elif t >= 55 or u >= 80 %}orange{% else %}green{% endif %}{% else %}grey{% endif %}",
                  "layout": "vertical",
                  "multiline_secondary": true,
                  "primary": "Synology",
                  "tap_action": {
                    "action": "navigate",
                    "navigation_path": "#synology"
                  },
                  "secondary": "{% if has_value('sensor.halcyon_temperature') %}Halcyon {{ states('sensor.halcyon_temperature') | int(0) }}°C · {{ states('sensor.halcyon_volume_1_volume_used') | float(0) | round(0) | int }}% full{% else %}offline{% endif %}",
                  "fill_container": false
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Maintenance",
                  "icon": "mdi:script-outline",
                  "icon_color": "gray\n",
                  "tap_action": {
                    "action": "navigate",
                    "navigation_path": "#maintenance"
                  },
                  "secondary": "",
                  "layout": "vertical",
                  "fill_container": false,
                  "multiline_secondary": true
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:bubble-card",
                  "card_type": "pop-up",
                  "hash": "#ups",
                  "margin_top_mobile": "-56px",
                  "bg_opacity": "0",
                  "close_on_click": false,
                  "bg_blur": "25",
                  "name": "UPS Power",
                  "icon": "mdi:sine-wave",
                  "width_desktop": "540px",
                  "button_type": "name",
                  "scrolling_effect": false,
                  "cards": [
                    {
                      "type": "custom:mushroom-template-card",
                      "entity": "sensor.ups_status_readable",
                      "primary": "{{ states('sensor.ups_status_readable') }}",
                      "icon": "{{ state_attr('sensor.ups_status_readable', 'icon') or 'mdi:battery-outline' }}",
                      "icon_color": "{% if states('sensor.ups_status_readable') in ['ONLINE', 'CHARGING'] %}\n  green\n{% elif states('sensor.ups_status_readable') == 'ON BATTERY' %}\n  orange\n{% elif states('sensor.ups_status_readable') == 'LOW BATTERY' %}\n  red\n{% else %}\n  gray\n{% endif %}",
                      "tap_action": {
                        "action": "more-info"
                      },
                      "secondary": "",
                      "grid_options": {
                        "columns": 12,
                        "rows": "auto"
                      }
                    },
