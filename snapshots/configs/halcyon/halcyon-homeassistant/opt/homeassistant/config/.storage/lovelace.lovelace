                  "width_desktop": "540px",
                  "sub_button": {
                    "bottom": [],
                    "main": []
                  },
                  "styles": ".bubble-icon-container { display: none !important; } .bubble-name-container { overflow: visible !important; margin-left: 12px !important; } .bubble-name { font-size: 26px !important; font-weight: 500 !important; line-height: 1.4 !important; overflow: visible !important; }",
                  "name": "Synology",
                  "close_on_click": false,
                  "hash": "#synology",
                  "button_type": "name",
                  "scrolling_effect": false,
                  "type": "custom:bubble-card",
                  "cards": [
                    {
                      "sub_button": {
                        "main": [
                          {
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "button.press",
                              "target": {
                                "entity_id": "button.halcyon_reboot"
                              },
                              "confirmation": {
                                "text": "Restart Halcyon? Its shares and the Hyper Backup will be interrupted until it is back."
                              }
                            },
                            "icon": "mdi:restart",
                            "name": "Restart",
                            "show_name": false,
                            "show_icon": true,
                            "show_background": true
                          },
                          {
                            "icon": "mdi:power",
                            "name": "Shut down",
                            "show_name": false,
                            "show_icon": true,
                            "show_background": true,
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "button.press",
                              "target": {
                                "entity_id": "button.halcyon_shutdown"
                              },
                              "confirmation": {
                                "text": "Shut down Halcyon? It will not come back until someone powers it on at the house."
                              }
                            }
                          }
                        ],
                        "bottom": []
                      },
                      "grid_options": {
                        "rows": "auto",
                        "columns": 12
                      },
                      "styles": ".bubble-icon { color: ${(() => { const s = hass.states; const g = (e) => s[e] ? s[e].state : 'unavailable'; const t = parseFloat(g('sensor.halcyon_temperature')); if (isNaN(t)) return 'var(--disabled-text-color)'; const u = parseFloat(g('sensor.halcyon_volume_1_volume_used')) || 0; if (t >= 70 || u >= 90 || g('sensor.halcyon_volume_1_status') !== 'normal' || g('binary_sensor.halcyon_security_status') === 'on') return 'var(--error-color)'; if (t >= 55 || u >= 80) return 'var(--warning-color)'; return 'var(--success-color)'; })()} !important; } .bubble-name-container { overflow: visible !important; } .bubble-name { font-size: 22px !important; font-weight: 600 !important; line-height: 1.4 !important; overflow: visible !important; } .bubble-icon { --mdc-icon-size: 28px !important; width: 28px !important; height: 28px !important; }",
                      "type": "custom:bubble-card",
                      "card_type": "separator",
                      "name": "Halcyon",
                      "icon": "mdi:nas"
                    },
                    {
                      "grid_options": {
                        "rows": "auto",
                        "columns": 12
                      },
                      "tap_action": {
                        "action": "more-info",
                        "entity": "sensor.halcyon_temperature"
                      },
                      "double_tap_action": {
                        "action": "none"
                      },
                      "card_mod": {
                        "style": "ha-card { border: none !important; box-shadow: none !important; --ha-card-border-width: 0px; background: transparent !important; margin-top: -24px !important; }"
                      },
                      "primary": "{% if has_value('sensor.halcyon_temperature') %}CPU {{ states('sensor.halcyon_cpu_utilisation_total') | int(0) }}% · RAM {{ states('sensor.halcyon_memory_usage_real') | int(0) }}% · {{ states('sensor.halcyon_temperature') | int(0) }}°C{% else %}Offline{% endif %}",
                      "fill_container": true,
                      "hold_action": {
                        "action": "none"
                      },
                      "type": "custom:mushroom-template-card",
                      "secondary": "{% if has_value('sensor.halcyon_temperature') %}↑ {{ states('sensor.halcyon_upload_throughput') | float(0) | round(0) | int }} kB/s · ↓ {{ states('sensor.halcyon_download_throughput') | float(0) | round(0) | int }} kB/s\nVolume 1 · {{ states('sensor.halcyon_volume_1_volume_used') | float(0) | round(0) | int }}% used ({{ states('sensor.halcyon_volume_1_used_space') | float(0) | round(1) }} TB){% else %}Unreachable{% endif %}",
                      "multiline_secondary": true
                    },
                    {
                      "type": "custom:bubble-card",
                      "card_type": "separator",
                      "name": "Hyper Backup",
                      "icon": "",
                      "sub_button": {
                        "bottom": [],
                        "main": []
                      },
                      "grid_options": {
                        "rows": "auto",
                        "columns": 12
                      },
                      "styles": ".bubble-icon-container { display: none !important; } .bubble-name-container { margin-left: 12px !important; } .bubble-name { font-size: 16px !important; font-weight: 500 !important; color: var(--secondary-text-color) !important; }"
                    },
                    {
                      "button_type": "switch",
                      "show_state": true,
                      "tap_action": {
                        "action": "toggle"
                      },
                      "grid_options": {
                        "rows": "auto",
                        "columns": 12
                      },
                      "styles": ".bubble-button-background { background: var(--card-background-color) !important; border-radius: 28px !important; } .bubble-sub-button { background-color: var(--card-background-color) !important; } .bubble-sub-button.auto, .bubble-sub-button.auto .bubble-sub-button-icon, .bubble-sub-button.auto .bubble-sub-button-name-container { color: ${hass.states['input_boolean.hb_throttle_schedule']?.state === 'on' ? 'var(--info-color)' : 'var(--primary-text-color)'} !important; } .bubble-sub-button.skip-today, .bubble-sub-button.skip-today .bubble-sub-button-icon, .bubble-sub-button.skip-today .bubble-sub-button-name-container { color: ${hass.states['input_boolean.hb_throttle_skip_today']?.state === 'on' ? 'var(--info-color)' : 'var(--primary-text-color)'} !important; } .bubble-state { visibility: hidden !important; position: relative !important; } .bubble-icon { color: ${hass.states['switch.hyper_backup_throttle']?.state === 'on' ? 'var(--info-color)' : 'var(--disabled-color)'} !important; } .bubble-state::after { visibility: visible; position: absolute; left: 0; content: \"${hass.states['switch.hyper_backup_throttle']?.state === 'on' ? ((v) => isNaN(v) ? 'On' : 'On · ↑ ' + v.toFixed(0) + ' kB/s')(parseFloat(hass.states['sensor.halcyon_upload_throughput']?.state)) : 'Off'}\"; }",
                      "type": "custom:bubble-card",
